---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { robotsDirective } from '../config/indexing';
import { origin, routes, localeFor, localizedPath, routeFor, isPublicPage } from '../i18n/routes';
import { brands } from '../data/brands';
import { breadcrumbLabels } from '../config/seo';
import { translate } from '../i18n/en';
import { shareImageOrigin } from '../config/seo';
import '../styles/global.css';

interface Props { title: string; description: string; className?: string }
const { title, description, className = '' } = Astro.props;
const locale = localeFor(Astro.url.pathname);
const canonical = origin + localizedPath(Astro.url.pathname, locale);
const publicPage = isPublicPage(Astro.url.pathname);
const t = (value: string) => locale === 'en' ? translate(value) : value;
const image = `${shareImageOrigin}/images/social/xionsgroup-og.png`;
// Breadcrumbs for every page below the home page. Google reads BreadcrumbList to show the
// site hierarchy in results instead of a bare URL; brand pages get the intermediate level.
const crumbRow = routeFor(Astro.url.pathname);
const crumbSlug = crumbRow ? crumbRow[locale === 'fr' ? 0 : 1] : '';
const crumbTrail = crumbSlug
  ? crumbSlug.split('/').map((_, i, parts) => parts.slice(0, i + 1).join('/'))
  : [];
const crumbName = (slug: string) => {
  const row = routes.find(r => r[locale === 'fr' ? 0 : 1] === slug);
  const label = row ? row[0] : slug;
  return t(breadcrumbLabels[label as keyof typeof breadcrumbLabels] ?? title);
};
const breadcrumb = crumbTrail.length ? [{
  '@type':'BreadcrumbList','@id':`${canonical}#breadcrumb`,
  itemListElement:[
    {'@type':'ListItem',position:1,name:t('Accueil'),item:`${origin}/${locale}/`},
    ...crumbTrail.map((slug, i) => ({
      '@type':'ListItem', position:i + 2, name:crumbName(slug), item:`${origin}/${locale}/${slug}/`
    }))
  ]
}] : [];

const schema = {
  '@context':'https://schema.org',
  '@graph':[
    {'@type':'Organization','@id':`${origin}/#organization`,name:'XIONS GROUP',legalName:'XIONS GROUP',url:origin,
      description:t('Groupe français indépendant qui crée, développe et déploie des marques de beauté premium à l’international.'),
      logo:{'@type':'ImageObject',url:`${origin}/images/site/xionsgroup-icon-512.png`,width:512,height:512},
      email:'contact@xionsgroup.com',
      address:{'@type':'PostalAddress',streetAddress:'253 rue Saint-Honoré',postalCode:'75001',addressLocality:'Paris',addressCountry:'FR'},
      // Must match the links the site actually shows: a second, different URL for the same
      // profile splits the entity instead of reinforcing it.
      sameAs:['https://instagram.com/xionsgroup','https://www.linkedin.com/company/xions-group'],
      subOrganization:brands.map(brand => ({
        '@type':'Brand','@id':`${origin}/#brand-${brand.slug}`,name:brand.name,
        url:`${origin}/${locale}/${locale === 'fr' ? 'marques' : 'brands'}/${brand.slug}/`,
        ...(brand.websiteLive ? {sameAs:[brand.website,...(brand.instagram ? [brand.instagram] : [])]} : {})
      }))},
    {'@type':'WebSite','@id':`${origin}/#website`,url:origin,name:'XIONS GROUP',inLanguage:['fr','en'],publisher:{'@id':`${origin}/#organization`}},
    ...breadcrumb,
    {'@type':'WebPage','@id':`${canonical}#webpage`,url:canonical,name:t(title),description:t(description),inLanguage:locale,
      isPartOf:{'@id':`${origin}/#website`},about:{'@id':`${origin}/#organization`},
      ...(crumbTrail.length ? {breadcrumb:{'@id':`${canonical}#breadcrumb`}} : {})}
  ]
};
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={publicPage ? robotsDirective : 'noindex, nofollow'} />
    <!-- Google Search Console ownership proof for the https://www.xionsgroup.com/ property.
         Removing it un-verifies the site, so it stays even after verification succeeds. -->
    <meta name="google-site-verification" content="bsyqGjcgUNSYNL7z8If9GfR_l9vy7_2xglj_Yqls9R4" />
    <link rel="canonical" href={canonical} />
    {routeFor(Astro.url.pathname) && <>
      <link rel="alternate" hreflang="fr" href={origin + localizedPath(Astro.url.pathname, 'fr')} />
      <link rel="alternate" hreflang="en" href={origin + localizedPath(Astro.url.pathname, 'en')} />
      <link rel="alternate" hreflang="x-default" href={origin + localizedPath(Astro.url.pathname, 'fr')} />
    </>}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="XIONS GROUP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_GB'} />
    <meta property="og:locale:alternate" content={locale === 'fr' ? 'en_GB' : 'fr_FR'} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="XIONS GROUP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content="XIONS GROUP" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/images/site/xionsgroup-icon-512.png?v=20260917" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/images/site/xionsgroup-icon-512.png?v=20260917" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Faculty+Glyphic:wght@400&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class={className}>
    <!-- Keyboard and screen-reader users land on the nav first on every single page. This jumps
         straight past it to the content; it stays off-screen until it takes focus. -->
    <a class="skip-link" href="#main-content">Aller au contenu</a>
    <Navigation />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer />
    {import.meta.env.DEV && <a id="local-preview-launcher" href={'/design-preview/?path=' + encodeURIComponent(Astro.url.pathname)} style="position:fixed;right:18px;bottom:18px;z-index:9999;background:#111;color:white;padding:10px 16px;border-radius:24px;text-decoration:none;font:12px system-ui">设计工具箱</a>}
    {import.meta.env.DEV && <script is:inline>if(window.self!==window.top)document.getElementById('local-preview-launcher')?.remove();</script>}
    <script>
      import { initReveal } from '../scripts/reveal';
      initReveal();
      // Dev-only in-place copy editing; the guard lets production tree-shake the whole module.
      if (import.meta.env.DEV) import('../scripts/text-edit-dev');
    </script>
  </body>
</html>
