---
const currentYear = new Date().getFullYear();

const footerLinks = {
  groupe: [
    { label: 'À propos', href: '/fr/groupe' },
    { label: 'Équipe', href: '/fr/groupe#equipe' },
    { label: 'Carrières', href: '/fr/carrieres' },
    { label: 'Contact', href: '/fr/contact' },
  ],
  marques: [
    { label: "L'Entropiste", href: '/fr/marques/lentropiste' },
    { label: 'Sunlution', href: '/fr/marques/sunlution' },
    { label: 'Masqly', href: '/fr/marques/masqly' },
    { label: 'Betenoir', href: '/fr/marques/betenoir' },
  ],
  legal: [
    { label: 'Mentions légales', href: '/fr/mentions-legales' },
    { label: 'Confidentialité', href: '/fr/politique-confidentialite' },
    { label: 'Cookies', href: '/fr/politique-cookies' },
  ],
};

const socialLinks = [
  { label: 'Instagram', href: 'https://instagram.com/xionsgroup', icon: 'instagram' },
  { label: 'LinkedIn', href: 'https://linkedin.com/company/xionsgroup', icon: 'linkedin' },
];
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-content">
      <!-- Logo -->
      <div class="footer-brand">
        <a href="/fr" class="footer-logo" aria-label="XIONS GROUP - Accueil">
          <img src="/XIONS_LOGO.svg" alt="XIONS GROUP" class="footer-logo-img" />
        </a>
      </div>
      
      <!-- Links -->
      <div class="footer-links">
        <div class="footer-column">
          <h4 class="footer-title">Groupe</h4>
          {footerLinks.groupe.map((link) => (
            <a href={link.href} class="footer-link">{link.label}</a>
          ))}
        </div>
        
        <div class="footer-column">
          <h4 class="footer-title">Marques</h4>
          {footerLinks.marques.map((link) => (
            <a href={link.href} class="footer-link">{link.label}</a>
          ))}
        </div>
        
        <div class="footer-column">
          <h4 class="footer-title">Suivez-nous</h4>
          {socialLinks.map((link) => (
            <a 
              href={link.href} 
              class="footer-link" 
              target="_blank" 
              rel="noopener noreferrer"
            >
              {link.label}
            </a>
          ))}
        </div>
        
        <div class="footer-column">
          <h4 class="footer-title">Contact</h4>
          <a href="mailto:contact@xionsgroup.com" class="footer-link">
            Email
          </a>
          <a href="/fr/contact" class="footer-link">
            Presse
          </a>
        </div>
      </div>
    </div>
    
    <!-- Bottom -->
    <div class="footer-bottom">
      <span class="footer-copyright">
        © {currentYear} XIONS GROUP. Tous droits réservés.
      </span>
      
      <div class="footer-legal">
        {footerLinks.legal.map((link, index) => (
          <>
            <a href={link.href} class="footer-legal-link">{link.label}</a>
            {index < footerLinks.legal.length - 1 && <span class="footer-separator">·</span>}
          </>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #FFFFFF;
    border-top: 0.5px solid rgba(0, 0, 0, 0.08);
    padding: 100px 0 60px;
    color: #0A0A0A;
  }
  
  .footer-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 80px;
  }
  
  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 80px;
  }
  
  .footer-brand {
    flex: 0 0 auto;
  }
  
  .footer-logo-img {
    height: 32px;
    width: auto;
    display: block;
    transition: opacity 0.3s ease;
  }
  
  .footer-logo:hover .footer-logo-img {
    opacity: 0.6;
  }
  
  .footer-links {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 60px;
    flex: 1;
    max-width: 800px;
  }
  
  .footer-column {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  
  .footer-title {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #0A0A0A;
    margin-bottom: 4px;
  }
  
  .footer-link {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: rgba(0, 0, 0, 0.6);
    text-decoration: none;
    transition: color 0.3s ease;
  }
  
  .footer-link:hover {
    color: #000000;
  }
  
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 30px;
    border-top: 0.5px solid rgba(0, 0, 0, 0.08);
  }
  
  .footer-copyright {
    font-size: 10px;
    letter-spacing: 0.08em;
    color: rgba(0, 0, 0, 0.4);
  }
  
  .footer-legal {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  
  .footer-legal-link {
    font-size: 10px;
    letter-spacing: 0.08em;
    color: rgba(0, 0, 0, 0.4);
    text-decoration: none;
    transition: color 0.3s ease;
  }
  
  .footer-legal-link:hover {
    color: #000000;
  }
  
  .footer-separator {
    font-size: 10px;
    color: rgba(0, 0, 0, 0.2);
  }
  
  @media (max-width: 1024px) {
    .footer-container {
      padding: 0 60px;
    }
    
    .footer-links {
      gap: 40px;
    }
  }
  
  @media (max-width: 768px) {
    .footer {
      padding: 80px 0 40px;
    }
    
    .footer-container {
      padding: 0 24px;
    }
    
    .footer-content {
      flex-direction: column;
      gap: 60px;
      margin-bottom: 60px;
    }
    
    .footer-links {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px;
      width: 100%;
    }
    
    .footer-bottom {
      flex-direction: column;
      gap: 20px;
      align-items: flex-start;
    }
    
    .footer-legal {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    
    .footer-separator {
      display: none;
    }
  }
</style>
