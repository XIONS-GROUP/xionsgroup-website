---
import Arrow from './Arrow.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-lead">
    <p class="eyebrow">Beauty · Creativity · Future</p>
    <a href="/fr/contact/">Imaginons la suite <span><Arrow /></span></a>
  </div>
  <div class="footer-grid">
    <a class="footer-logo" href="/fr/"><img src="/images/site/xions-logo.svg" alt="XIONS GROUP" /></a>
    <div><span>Explorer</span><a href="/fr/groupe/">Le groupe</a><a href="/fr/marques/">Nos marques</a><a href="/fr/engagements/">Engagements</a></div>
    <div><span class="col-spacer" aria-hidden="true"></span><a href="/fr/presse/">Presse & rayonnement</a><a href="/fr/carrieres/">Carrières</a><a href="/fr/contact/">Contact</a></div>
    <div><span>Suivre</span><a href="https://instagram.com/xionsgroup" target="_blank" rel="noreferrer">Instagram</a><a href="https://www.linkedin.com/company/xions-group" target="_blank" rel="noreferrer">LinkedIn</a><a href="mailto:contact@xionsgroup.com">Email</a></div>
  </div>
  <div class="footer-bottom">
    <p>© {year} XIONS GROUP</p>
    <LanguageSwitcher compact />
  </div>
  <div class="footer-legal"><a href="/fr/conditions-generales/">Conditions d’utilisation</a><a href="/fr/mentions-legales/">Mentions légales</a><a href="/fr/politique-confidentialite/">Confidentialité</a><a href="/fr/politique-cookies/">Cookies</a></div>
</footer>
<style>
  /* Keep the arrow on its own line on desktop. Left to wrap naturally it follows the last word
     or not depending on how long the phrase is, so French and English broke differently. */
  @media(min-width:701px) { .footer-lead > a span { display:block; } }
  /* The language toggle was buried in the legal row; it now shares the copyright line and sits
     hard right, where it reads as a control rather than one more legal link. */
  .footer-bottom { display:flex; justify-content:space-between; align-items:baseline; gap:1rem 2rem; }
  /* This column's heading was dropped as a duplicate, but the row it occupied has to stay so
     its links keep sitting level with the other columns'. Inherits the heading's size/margin. */
  /* A zero-width space gives it the same line box as a heading with text; min-height:1em was
     6px short because it ignored line-height. */
  .col-spacer { display:block; }
  .col-spacer::before { content:'\200B'; }
  /* Moved out of .footer-bottom, so it lost that block's small type and its link reset —
     which is why these read larger and underlined. Restored here. */
  .footer-legal { display:flex; align-items:baseline; flex-wrap:wrap; gap:.6rem 1.75rem; margin-top:1.25rem;
    color:#918d85; font-size:.67rem; letter-spacing:.02em; }
  .footer-legal a { text-decoration:none; }
  @media(max-width:700px) { .footer-legal { gap:.5rem 1.25rem; } }
</style>
