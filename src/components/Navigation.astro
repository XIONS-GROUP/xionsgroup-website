---
const navItems = [
  { label: 'GROUPE', href: '/fr/groupe' },
  { label: 'MARQUES', href: '/fr/marques' },
  { label: 'ENGAGEMENTS', href: '/fr/engagements' },
  { label: 'CONTACT', href: '/fr/contact' },
];
---

<nav class="nav" aria-label="Navigation principale">
  <div class="nav-container">
    <a href="/fr" class="nav-logo" aria-label="XIONS GROUP - Accueil">
      <img src="/XIONS_LOGO.svg" alt="XIONS GROUP" class="nav-logo-img" />
    </a>
    
    <div class="nav-menu">
      {navItems.map((item) => (
        <a href={item.href} class="nav-link">
          {item.label}
        </a>
      ))}
    </div>
    
    <div class="nav-right">
      <button class="nav-lang" aria-label="Changer de langue">
        FR
      </button>
    </div>
    
    <!-- Mobile menu button -->
    <button class="nav-toggle" aria-label="Menu" aria-expanded="false">
      <span></span>
      <span></span>
    </button>
  </div>
  
  <!-- Mobile menu -->
  <div class="nav-mobile" aria-hidden="true">
    {navItems.map((item) => (
      <a href={item.href} class="nav-mobile-link">
        {item.label}
      </a>
    ))}
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(6, 6, 6, 0.82);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 0.5px solid rgba(255, 255, 255, 0.1);
    transition: background 0.3s ease, border-color 0.3s ease;
  }
  
  .nav-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  /* Logo */
  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }
  
  .nav-logo-img {
    height: 32px;
    width: auto;
    filter: invert(1);
    display: block;
  }

  .nav-logo:hover {
    opacity: 0.75;
  }
  
  /* Navigation Links */
  .nav-menu {
    display: flex;
    gap: 48px;
    align-items: center;
  }
  
  .nav-link {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    position: relative;
    transition: color 0.3s ease;
  }
  
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 50%;
    width: 0;
    height: 1px;
    background: #FFFFFF;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .nav-link:hover {
    color: #FFFFFF;
  }

  .nav-link:hover::after {
    width: 100%;
    left: 0;
  }
  
  /* Language Selector */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  
  .nav-lang {
    background: transparent;
    border: 0.5px solid rgba(255, 255, 255, 0.25);
    color: rgba(255, 255, 255, 0.9);
    padding: 6px 14px;
    font-size: 10px;
    letter-spacing: 0.15em;
    cursor: pointer;
    transition: all 0.3s ease;
    border-radius: 20px;
  }
  
  .nav-lang:hover {
    background: #FFFFFF;
    color: #000000;
  }
  
  /* Mobile Toggle */
  .nav-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    flex-direction: column;
    gap: 6px;
  }
  
  .nav-toggle span {
    display: block;
    width: 24px;
    height: 1px;
    background: #FFFFFF;
    transition: transform 0.3s ease;
  }
  
  /* Mobile Menu */
  .nav-mobile {
    display: none;
  }
  
  @media (max-width: 1024px) {
    .nav-container {
      padding: 0 40px;
    }
    
    .nav-menu {
      gap: 32px;
    }
  }
  
  @media (max-width: 768px) {
    .nav-container {
      padding: 0 24px;
      height: 70px;
    }
    
    .nav-menu,
    .nav-right {
      display: none;
    }
    
    .nav-toggle {
      display: flex;
    }
    
    .nav-mobile {
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 70px;
      left: 0;
      right: 0;
      bottom: 0;
      background: #060606;
      padding: 40px 24px;
      gap: 24px;
      transform: translateY(-100%);
      opacity: 0;
      transition: all 0.4s ease;
      pointer-events: none;
    }
    
    .nav-mobile.is-active {
      transform: translateY(0);
      opacity: 1;
      pointer-events: all;
    }
    
    .nav-mobile-link {
      font-size: 18px;
      letter-spacing: 0.15em;
      color: #FFFFFF;
      text-decoration: none;
      text-transform: uppercase;
    }
  }
</style>
