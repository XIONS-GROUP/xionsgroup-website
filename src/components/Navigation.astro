---
import { brands } from '../data/brands';
const path = Astro.url.pathname.replace(/\/$/, '');
const items = [
  { label: 'Le groupe', href: '/fr/groupe', links: [
    ['À propos', '/fr/groupe'], ['Notre équipe', '/fr/groupe#direction']
  ] },
  { label: 'Nos marques', href: '/fr/marques', links: [
    ['Toutes nos marques', '/fr/marques'], ...brands.map(b => [b.name, `/fr/marques/${b.slug}`])
  ] }
];
const directLinks = [
  ['Press', '/fr/presse'],
  ['Engagements', '/fr/engagements'],
  ['Carrières', '/fr/carrieres']
] as const;
---
<header class="navigation">
  <a class="navigation-logo" href="/fr" aria-label="XIONS Group — Accueil"><img src="/XIONS_LOGO.svg" alt="XIONS Group" width="140" height="42" /></a>
  <nav class="navigation-desktop" aria-label="Navigation principale">
    {items.map((item, i) => <div class="navigation-item">
      <button class:list={['navigation-trigger', {current: item.links.some(([,href]) => path === href.split('#')[0])}]} aria-expanded="false" aria-controls={`navigation-panel-${i}`}>{item.label}</button>
      <div class="navigation-panel" id={`navigation-panel-${i}`} hidden>
        <div class="navigation-panel-inner"><p>{item.label}</p><div>{item.links.map(([label, href]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}</div></div>
      </div>
    </div>)}
    {directLinks.map(([label, href]) => <a class:list={['navigation-direct', {current: path === href}]} href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
    <a class="navigation-contact" href="/fr/contact" aria-current={path === '/fr/contact' ? 'page' : undefined}>Contact</a>
  </nav>
  <button class="navigation-toggle" aria-expanded="false" aria-controls="navigation-mobile">Menu</button>
  <nav class="navigation-mobile" id="navigation-mobile" aria-label="Navigation mobile" hidden>
    {items.map(item => <div><a class="mobile-primary" href={item.href}>{item.label}</a>{item.links.filter(([,href]) => href !== item.href).map(([label,href]) => <a href={href}>{label}</a>)}</div>)}
    {directLinks.map(([label, href]) => <a class="mobile-primary" href={href}>{label}</a>)}
    <a class="mobile-primary" href="/fr/contact">Contact</a>
  </nav>
</header>
<style>
  .navigation { position:fixed; inset:0 0 auto; z-index:100; height:var(--header); padding-inline:var(--pad); display:flex; justify-content:space-between; align-items:center; background:var(--paper); }
  .navigation-logo img { width:8.75rem; height:2.6rem; object-fit:contain; }
  .navigation-desktop { display:flex; align-items:center; gap:clamp(1rem,2vw,2.5rem); height:100%; }
  .navigation-item { display:flex; align-items:center; height:100%; }
  .navigation-trigger,.navigation-direct,.navigation-contact,.navigation-toggle { padding:.7rem 0; color:var(--ink); border:0; background:none; font:inherit; font-size:.72rem; letter-spacing:.12em; text-transform:uppercase; text-decoration:none; cursor:pointer; }
  .navigation-trigger:hover,.navigation-direct:hover,.navigation-contact:hover,.navigation-trigger.current,.navigation-direct.current { color:var(--muted); }
  .navigation-panel { position:absolute; inset:100% 0 auto; background:var(--paper); padding:2rem var(--pad) 3rem; }
  .navigation-panel[hidden],.navigation-mobile[hidden] { display:none; }
  .navigation-panel-inner { max-width:78rem; margin:auto; display:grid; grid-template-columns:1fr 2fr; gap:3rem; }
  .navigation-panel p { color:var(--muted); font-size:.8rem; margin:0; }
  .navigation-panel-inner>div { display:grid; grid-template-columns:1fr 1fr; gap:1rem 3rem; }
  .navigation-panel a { font-size:1.1rem; text-decoration:none; }
  .navigation-panel a:hover { color:var(--muted); }
  .navigation-toggle,.navigation-mobile { display:none; }
  @media(max-width:900px) {
    .navigation-desktop { display:none; }
    .navigation-toggle { display:block; }
    .navigation-mobile:not([hidden]) { display:block; position:absolute; inset:100% 0 auto; max-height:calc(100svh - var(--header)); overflow:auto; background:var(--paper); padding:1rem var(--pad) 3rem; }
    .navigation-mobile>div { margin-bottom:1.75rem; }
    .navigation-mobile a { display:block; width:fit-content; padding:.3rem 0; text-decoration:none; font-size:.95rem; }
    .navigation-mobile a.mobile-primary { font-family:var(--display); font-size:1.7rem; margin-bottom:.4rem; }
  }
</style>
<script>
  const header = document.querySelector<HTMLElement>('.navigation')!;
  const triggers = [...header.querySelectorAll<HTMLButtonElement>('.navigation-trigger')];
  const mobileButton = header.querySelector<HTMLButtonElement>('.navigation-toggle')!;
  const mobile = header.querySelector<HTMLElement>('.navigation-mobile')!;
  const panels = triggers.map(button => document.getElementById(button.getAttribute('aria-controls')!)!);
  function closeDesktop() { triggers.forEach((button,i) => { button.setAttribute('aria-expanded','false'); panels[i].hidden=true; }); }
  function openPanel(index:number) { closeDesktop(); triggers[index].setAttribute('aria-expanded','true'); panels[index].hidden=false; }
  function closeMobile() { mobile.hidden=true; mobileButton.setAttribute('aria-expanded','false'); mobileButton.textContent='Menu'; }
  triggers.forEach((button,i) => {
    button.addEventListener('click',event => { if(event.detail > 0) openPanel(i); else button.getAttribute('aria-expanded') === 'true' ? closeDesktop() : openPanel(i); });
    button.parentElement!.addEventListener('pointerenter',event => { if(event.pointerType === 'mouse') openPanel(i); });
    button.addEventListener('keydown',event => { if(event.key === 'ArrowDown') { event.preventDefault(); openPanel(i); panels[i].querySelector('a')?.focus(); } });
  });
  header.addEventListener('pointerleave',event => { if(event.pointerType === 'mouse' && !panels.some(panel => panel.contains(document.activeElement))) closeDesktop(); });
  header.addEventListener('focusout',event => { if(!header.contains(event.relatedTarget as Node)) { closeDesktop(); closeMobile(); } });
  mobileButton.addEventListener('click',() => { const open=mobile.hidden; mobile.hidden=!open; mobileButton.setAttribute('aria-expanded',String(open)); mobileButton.textContent=open?'Fermer':'Menu'; });
  mobile.querySelectorAll('a').forEach(a => a.addEventListener('click',closeMobile));
  document.addEventListener('pointerdown',event => { if(!header.contains(event.target as Node)) { closeDesktop(); closeMobile(); } });
  document.addEventListener('keydown',event => { if(event.key !== 'Escape') return; const active=triggers.findIndex(b => b.getAttribute('aria-expanded') === 'true'); if(active>=0) { closeDesktop(); triggers[active].focus(); } if(!mobile.hidden) { closeMobile(); mobileButton.focus(); } });
  matchMedia('(max-width:900px)').addEventListener('change',() => { closeDesktop(); closeMobile(); });
</script>
