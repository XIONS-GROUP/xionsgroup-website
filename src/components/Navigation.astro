---
import { brands } from '../data/brands';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fr') ? 'fr' : 'en';

const brandsList = brands.map(brand => ({
  name: brand.name,
  href: `/${lang}/marques/${brand.slug}`
}));

const navItems = {
  fr: [
    { label: 'Le Groupe', href: '/fr/groupe' },
    {
      label: 'Marques',
      href: '/fr/marques',
      submenu: [
        ...brandsList,
        { name: 'Toutes nos marques', href: '/fr/marques', highlight: true }
      ]
    },
    { label: 'Engagements', href: '/fr/engagements' },
    { label: 'Rayonnement', href: '/fr/presse' },
    { label: 'Carrières', href: '/fr/carrieres' },
    { label: 'Contact', href: '/fr/contact' }
  ],
  en: [
    { label: 'About', href: '/en/about' },
    {
      label: 'Brands',
      href: '/en/brands',
      submenu: [
        ...brandsList,
        { name: 'All our brands', href: '/en/brands', highlight: true }
      ]
    },
    { label: 'Commitments', href: '/en/commitments' },
    { label: 'Press', href: '/en/press' },
    { label: 'Careers', href: '/en/careers' },
    { label: 'Contact', href: '/en/contact' }
  ]
};

const items = navItems[lang as keyof typeof navItems];
---

<header class="site-header">
  <div class="header-container">
    <!-- Official Logo -->
    <a href={`/${lang}`} class="header-logo" aria-label="XIONS GROUP">
      <img src="/XIONS_LOGO.svg" alt="XIONS GROUP" class="logo-img" onerror="this.src='/XIONS_Horizontal_White_LOGO.png'" />
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Navigation principale">
      {items.map((item) => (
        <div class="nav-item-wrapper">
          <a
            href={item.href}
            class:list={['nav-link', { active: currentPath === item.href }]}
          >
            {item.label}
            {item.submenu && (
              <svg class="chevron" width="8" height="5" viewBox="0 0 8 5" fill="none"><path d="M1 1L4 4L7 1" stroke="currentColor" stroke-width="0.8"/></svg>
            )}
          </a>

          {item.submenu && (
            <div class="mega-dropdown">
              <div class="dropdown-bridge"></div>
              <div class="dropdown-content">
                <span class="dropdown-heading">{lang === 'fr' ? 'Nos Maisons' : 'Our Houses'}</span>
                <div class="dropdown-links">
                  {item.submenu.map(sub => (
                    <a href={sub.href} class:list={['dropdown-link', { highlight: sub.highlight }]}>
                      {sub.name}
                      {sub.highlight && <span class="arrow">→</span>}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <a href="/fr/contact" class="contact-pill">CONTACT</a>
    </div>

    <!-- Mobile Menu Toggle -->
    <button class="mobile-toggle" aria-label="Menu" aria-expanded="false">
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(254, 253, 251, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 0.5px solid rgba(10, 9, 8, 0.08);
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  .header-container {
    max-width: 86rem;
    margin: 0 auto;
    padding: 0 2.5rem;
    height: 5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  /* Logo */
  .header-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-img {
    height: 2.2rem;
    width: auto;
    display: block;
    transition: opacity 0.3s ease;
  }

  .header-logo:hover .logo-img {
    opacity: 0.75;
  }

  /* Desktop Nav Container */
  .desktop-nav {
    display: none;
    align-items: center;
    gap: 2.2rem;
    height: 100%;
  }

  @media (min-width: 1024px) {
    .desktop-nav {
      display: flex;
    }
  }

  .nav-item-wrapper {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .nav-link {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0;
    transition: color 0.3s ease, opacity 0.3s ease;
  }

  .nav-link:hover {
    opacity: 0.65;
  }

  .nav-link.active {
    font-weight: 600;
  }

  .chevron {
    transition: transform 0.3s ease;
    opacity: 0.5;
  }

  .nav-item-wrapper:hover .chevron {
    transform: rotate(180deg);
    opacity: 1;
  }

  /* 🌟 Dropdown Menu Bug Fix & Clean Hover */
  .mega-dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1100;
  }

  /* 无缝过渡垫 */
  .dropdown-bridge {
    height: 12px;
    width: 100%;
  }

  .dropdown-content {
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 0.5px solid rgba(10, 9, 8, 0.1);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
    border-radius: 4px;
    padding: 1.5rem;
    min-width: 220px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .nav-item-wrapper:hover .mega-dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
    transform: translateX(-50%) translateY(0);
  }

  .dropdown-heading {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: 0.5rem;
    border-bottom: 0.5px solid rgba(10, 9, 8, 0.08);
  }

  .dropdown-links {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .dropdown-link {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--ink);
    text-decoration: none;
    padding: 0.4rem 0.6rem;
    border-radius: 4px;
    transition: background 0.2s ease, color 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .dropdown-link:hover {
    background: rgba(10, 9, 8, 0.04);
    color: #000000;
  }

  .dropdown-link.highlight {
    font-weight: 600;
    margin-top: 0.25rem;
    border-top: 0.5px solid rgba(10, 9, 8, 0.08);
    padding-top: 0.6rem;
  }

  /* Actions */
  .header-actions {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .contact-pill {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-decoration: none;
    color: var(--ink);
    padding: 0.5rem 1.2rem;
    border: 0.5px solid rgba(10, 9, 8, 0.25);
    border-radius: 20px;
    transition: all 0.3s ease;
  }

  .contact-pill:hover {
    background: var(--ink);
    color: var(--paper);
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  @media (min-width: 1024px) {
    .mobile-toggle {
      display: none;
    }
  }

  .mobile-toggle span {
    display: block;
    width: 22px;
    height: 1px;
    background: var(--ink);
    transition: transform 0.3s ease;
  }
</style>
