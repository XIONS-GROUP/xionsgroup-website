---
import { brands } from '../data/brands';

const currentPath = Astro.url.pathname;

const navItems = [
  {
    key: 'groupe',
    label: 'Le Groupe',
    href: '/fr/groupe',
    sections: [
      {
        heading: 'Vision & Ambition',
        links: [
          { label: 'À propos du Groupe', href: '/fr/groupe', desc: 'Notre vision de la beauté nouvelle génération' },
          { label: 'Fondateurs & Direction', href: '/fr/groupe#direction', desc: 'Denis Bellaïche, Kris Fang, Neo Su' }
        ]
      },
      {
        heading: 'Culture & Écosystème',
        links: [
          { label: 'Presse & Événements', href: '/fr/presse', desc: 'Oscars, Cannes, Fragrance Foundation' },
          { label: 'Carrières & Talents', href: '/fr/carrieres', desc: 'Rejoindre nos équipes créatives' }
        ]
      }
    ],
    highlight: {
      title: 'Maison de Haute Création',
      desc: 'Un groupe français indépendant façonné par l\'exigence créative, la science et la culture.'
    }
  },
  {
    key: 'marques',
    label: 'Nos Marques',
    href: '/fr/marques',
    sections: [
      {
        heading: 'Parfumerie de Niche',
        links: [
          { label: "L'Entropiste", href: '/fr/marques/lentropiste', badge: 'Award 2026', desc: 'Parfumerie libre, contemporaine et inattendue' },
          { label: 'Betenoir', href: '/fr/marques/betenoir', badge: 'Coming 2026', desc: 'Prochaine création olfactive ténébreuse' }
        ]
      },
      {
        heading: 'Cosmétique & Soin',
        links: [
          { label: 'Sunlution', href: '/fr/marques/sunlution', desc: 'La science avancée de la lumière pour la peau' },
          { label: 'Masqly', href: '/fr/marques/masqly', desc: 'Rituel soin ciblé et performance dermo-esthétique' }
        ]
      }
    ],
    highlight: {
      title: 'Portefeuille Global',
      desc: 'Quatre maisons indépendantes qui réinventent les codes de la beauté premium.',
      actionLabel: 'Toutes nos marques →',
      actionHref: '/fr/marques'
    }
  },
  {
    key: 'engagements',
    label: 'Engagements',
    href: '/fr/engagements',
    sections: [
      {
        heading: 'Nos Piliers Exécutifs',
        links: [
          { label: 'Qualité & Formulation', href: '/fr/engagements#qualite', desc: 'Ingrédients d\'exception et normes élevées' },
          { label: 'Éthique & Indépendance', href: '/fr/engagements#responsabilite', desc: 'Transparence totale et traçabilité' },
          { label: 'Éco-conception', href: '/fr/engagements#environnement', desc: 'Durabilité et réduction de l\'empreinte carbone' }
        ]
      }
    ],
    highlight: {
      title: 'Responsabilité & Futur',
      desc: 'Des standards d\'exception pour imprimer un impact positif et durable.'
    }
  },
  {
    key: 'presse',
    label: 'Rayonnement',
    href: '/fr/presse',
    sections: [
      {
        heading: 'Médias & Événements',
        links: [
          { label: 'Revue de Presse', href: '/fr/presse', desc: 'Articles, communiqués et actualités' },
          { label: 'Grands Rendez-vous', href: '/fr/presse#evenements', desc: 'Cannes, Oscars, Golden Globes, Fashion Week' }
        ]
      }
    ],
    highlight: {
      title: 'Présence Internationale',
      desc: 'Une résonance mondiale au cœur des plus grands événements culturels.'
    }
  },
  {
    key: 'carrieres',
    label: 'Carrières',
    href: '/fr/carrieres',
    sections: [
      {
        heading: 'Rejoindre l\'Aventure',
        links: [
          { label: 'Esprit & Culture', href: '/fr/carrieres', desc: 'Excellence, création et esprit d\'entreprendre' },
          { label: 'Opportunités', href: '/fr/carrieres#postes', desc: 'Marketing, R&D, Création et Supply Chain' }
        ]
      }
    ],
    highlight: {
      title: 'Talents & Ambition',
      desc: 'Façonnez l\'avenir de la beauté aux côtés d\'équipes passionnées.'
    }
  },
  {
    key: 'contact',
    label: 'Contact',
    href: '/fr/contact',
    sections: [
      {
        heading: 'Bureaux & Demandes',
        links: [
          { label: 'Siège Paris & Général', href: '/fr/contact?type=general', desc: 'Demandes institutionnelles et siège social' },
          { label: 'Presse & Médias', href: '/fr/contact?type=press', desc: 'Relations presse et partenariats' },
          { label: 'Business & Distribution', href: '/fr/contact?type=business', desc: 'Opportunités de développement international' }
        ]
      }
    ],
    highlight: {
      title: 'Écrivez-nous',
      desc: 'Nos équipes à Paris vous répondent pour toute opportunité de collaboration.'
    }
  }
];
---

<header class="site-header">
  <div class="header-container">
    <!-- Official Logo -->
    <a href="/fr" class="header-logo" aria-label="XIONS GROUP">
      <img src="/XIONS_LOGO.svg" alt="XIONS GROUP" class="logo-img" onerror="this.src='/XIONS_Horizontal_White_LOGO.png'" />
    </a>

    <!-- Desktop Navigation with Full-Width Glass Mega Dropdowns -->
    <nav class="desktop-nav" aria-label="Navigation principale">
      {navItems.map((item) => (
        <div class="nav-item-wrapper">
          <a
            href={item.href}
            class:list={['nav-link', { active: currentPath.startsWith(item.href) }]}
          >
            {item.label}
            <svg class="chevron" width="8" height="5" viewBox="0 0 8 5" fill="none">
              <path d="M1 1L4 4L7 1" stroke="currentColor" stroke-width="0.8"/>
            </svg>
          </a>

          <!-- Full-Width Translucent Glassmorphism Mega Dropdown Menu -->
          <div class="full-mega-dropdown">
            <div class="dropdown-bridge"></div>
            <div class="mega-container">
              <div class="mega-sections">
                {item.sections.map(section => (
                  <div class="mega-column">
                    <span class="mega-heading">{section.heading}</span>
                    {section.links.map(link => (
                      <a href={link.href} class="mega-link-item">
                        <div class="mega-link-header">
                          <span class="mega-link-title">{link.label}</span>
                          {link.badge && <span class="mega-badge">{link.badge}</span>}
                        </div>
                        <span class="mega-link-desc">{link.desc}</span>
                      </a>
                    ))}
                  </div>
                ))}
              </div>

              {item.highlight && (
                <div class="mega-highlight-box">
                  <div>
                    <span class="highlight-eyebrow">XIONS GROUP</span>
                    <h4 class="highlight-title">{item.highlight.title}</h4>
                    <p class="highlight-desc">{item.highlight.desc}</p>
                  </div>
                  {item.highlight.actionHref && (
                    <a href={item.highlight.actionHref} class="highlight-action">
                      {item.highlight.actionLabel}
                    </a>
                  )}
                </div>
              )}
            </div>
          </div>
        </div>
      ))}
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <a href="/fr/contact" class="contact-pill">CONTACT</a>
    </div>

    <!-- Mobile Menu Toggle -->
    <button class="mobile-toggle" aria-label="Menu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Mobile Overlay Menu -->
  <div class="mobile-menu" aria-hidden="true">
    <nav>
      {navItems.map((item, idx) => (
        <div class="mobile-nav-group">
          <a href={item.href} class="mobile-link">
            <span>0{idx + 1}</span> {item.label}
          </a>
        </div>
      ))}
      <a href="/fr/contact" class="mobile-link contact-mobile">CONTACT ↗</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(254, 253, 251, 0.90);
    backdrop-filter: blur(24px) saturate(1.8);
    -webkit-backdrop-filter: blur(24px) saturate(1.8);
    border-bottom: 0.5px solid rgba(10, 9, 8, 0.08);
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  .header-container {
    max-width: 86rem;
    margin: 0 auto;
    padding: 0 2.5rem;
    height: 5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  /* Logo */
  .header-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-img {
    height: 2.2rem;
    width: auto;
    display: block;
    transition: opacity 0.3s ease;
  }

  .header-logo:hover .logo-img {
    opacity: 0.75;
  }

  /* Desktop Nav */
  .desktop-nav {
    display: none;
    align-items: center;
    gap: 2.2rem;
    height: 100%;
  }

  @media (min-width: 1024px) {
    .desktop-nav {
      display: flex;
    }
  }

  .nav-item-wrapper {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .nav-link {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    height: 100%;
    padding: 0 0.1rem;
    transition: color 0.3s ease, opacity 0.3s ease;
  }

  .nav-link:hover {
    opacity: 0.65;
  }

  .nav-link.active {
    font-weight: 600;
  }

  .chevron {
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0.45;
  }

  .nav-item-wrapper:hover .chevron {
    transform: rotate(180deg);
    opacity: 1;
  }

  /* 🌟 FULL-WIDTH TRANSLUCENT GLASSMEGA DROPDOWN MENU (全屏宽磨砂半透明下拉菜单) */
  .full-mega-dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    width: 100vw;
    background: rgba(254, 253, 251, 0.94);
    backdrop-filter: blur(36px) saturate(1.8);
    -webkit-backdrop-filter: blur(36px) saturate(1.8);
    border-top: 0.5px solid rgba(10, 9, 8, 0.08);
    border-bottom: 0.5px solid rgba(10, 9, 8, 0.08);
    box-shadow: 0 30px 60px rgba(10, 9, 8, 0.07);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1100;
  }

  .dropdown-bridge {
    position: absolute;
    top: -16px;
    left: 0;
    right: 0;
    height: 16px;
  }

  .nav-item-wrapper:hover .full-mega-dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
    transform: translateX(-50%) translateY(0);
  }

  .mega-container {
    max-width: 86rem;
    margin: 0 auto;
    padding: 2.8rem 2.5rem;
    display: grid;
    grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr);
    gap: 4rem;
    align-items: start;
  }

  .mega-sections {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2.5rem;
  }

  .mega-column {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .mega-heading {
    font-family: 'Faculty Glyphic', serif;
    font-size: 1rem;
    letter-spacing: 0.02em;
    color: var(--ink);
    padding-bottom: 0.5rem;
    border-bottom: 0.5px solid rgba(10, 9, 8, 0.1);
  }

  .mega-link-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
    padding: 0.5rem 0.6rem;
    border-radius: 4px;
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .mega-link-item:hover {
    background: rgba(10, 9, 8, 0.035);
    transform: translateX(4px);
  }

  .mega-link-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .mega-link-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink);
  }

  .mega-badge {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 0.15rem 0.5rem;
    border-radius: 10px;
    background: rgba(139, 38, 53, 0.08);
    color: var(--wine);
    text-transform: uppercase;
  }

  .mega-link-desc {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.78rem;
    color: var(--muted);
    font-weight: 400;
    line-height: 1.4;
  }

  /* Highlight Box inside Mega Dropdown */
  .mega-highlight-box {
    background: rgba(10, 9, 8, 0.025);
    border: 0.5px solid rgba(10, 9, 8, 0.08);
    border-radius: 6px;
    padding: 1.8rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100%;
  }

  .highlight-eyebrow {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    display: block;
    margin-bottom: 0.5rem;
  }

  .highlight-title {
    font-family: 'Faculty Glyphic', serif;
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--ink);
    margin: 0 0 0.6rem 0;
    line-height: 1.25;
  }

  .highlight-desc {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.83rem;
    color: var(--muted);
    line-height: 1.5;
    margin: 0 0 1.2rem 0;
  }

  .highlight-action {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--wine);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: transform 0.25s ease;
  }

  .highlight-action:hover {
    transform: translateX(4px);
  }

  /* Actions */
  .header-actions {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .contact-pill {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-decoration: none;
    color: var(--ink);
    padding: 0.5rem 1.2rem;
    border: 0.5px solid rgba(10, 9, 8, 0.25);
    border-radius: 20px;
    transition: all 0.3s ease;
  }

  .contact-pill:hover {
    background: var(--ink);
    color: var(--paper);
  }

  /* Mobile Toggle & Menu */
  .mobile-toggle {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  @media (min-width: 1024px) {
    .mobile-toggle {
      display: none;
    }
  }

  .mobile-toggle span {
    display: block;
    width: 22px;
    height: 1px;
    background: var(--ink);
    transition: transform 0.3s ease;
  }

  .mobile-menu {
    position: fixed;
    top: 5rem;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(10, 9, 8, 0.98);
    backdrop-filter: blur(32px);
    display: none;
    padding: 3rem 2.5rem;
    flex-direction: column;
    justify-content: space-between;
    z-index: 999;
  }

  .mobile-menu.active {
    display: flex;
  }

  .mobile-menu nav {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .mobile-link {
    font-family: 'Faculty Glyphic', serif;
    font-size: 2rem;
    color: var(--paper);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 1rem;
    transition: transform 0.3s ease;
  }

  .mobile-link span {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .mobile-link:hover {
    transform: translateX(0.5rem);
  }

  .contact-mobile {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1rem;
    letter-spacing: 0.15em;
    color: var(--wine);
    margin-top: 2rem;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.querySelector('.mobile-toggle');
    const menu = document.querySelector('.mobile-menu');

    toggle?.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', (!isExpanded).toString());
      menu?.classList.toggle('active');
    });
  });
</script>
