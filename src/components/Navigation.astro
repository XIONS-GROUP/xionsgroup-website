---
import { brands } from '../data/brands';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fr') ? 'fr' : 'en';

const brandsList = brands.map(brand => ({
  name: brand.name,
  href: `/${lang}/marques/${brand.slug}`
}));

const navItems = {
  fr: [
    { label: 'Le Groupe', href: '/fr/groupe' },
    { 
      label: 'Marques', 
      href: '/fr/marques',
      submenu: [
        ...brandsList,
        { name: 'Toutes nos marques', href: '/fr/marques', highlight: true }
      ]
    },
    { label: 'Engagements', href: '/fr/engagements' },
    { label: 'Rayonnement', href: '/fr/presse' },
    { label: 'Carrières', href: '/fr/carrieres' },
    { label: 'Contact', href: '/fr/contact' }
  ],
  en: [
    { label: 'About', href: '/en/about' },
    { 
      label: 'Brands', 
      href: '/en/brands',
      submenu: [
        ...brandsList,
        { name: 'All our brands', href: '/en/brands', highlight: true }
      ]
    },
    { label: 'Commitments', href: '/en/commitments' },
    { label: 'Press', href: '/en/press' },
    { label: 'Careers', href: '/en/careers' },
    { label: 'Contact', href: '/en/contact' }
  ]
};

const items = navItems[lang as keyof typeof navItems];
---

<header class="site-header">
  <div class="container">
    <a href={`/${lang}`} class="logo">XIONS GROUP</a>
    
    <nav class="desktop-nav">
      {items.map((item) => (
        <div class="nav-item-wrapper">
          <a 
            href={item.href} 
            class:list={['nav-link', { active: currentPath === item.href }]}
          >
            {item.label}
          </a>
          {item.submenu && (
            <div class="mega-dropdown">
              <div class="container">
                <div class="submenu-content">
                  <div class="submenu-title">{lang === 'fr' ? 'Nos Marques' : 'Our Brands'}</div>
                  <div class="brands-grid">
                    {item.submenu.filter(sub => !sub.highlight).map(sub => (
                      <a href={sub.href} class="brand-link">
                        {sub.name}
                      </a>
                    ))}
                  </div>
                  {item.submenu.filter(sub => sub.highlight).map(sub => (
                    <a href={sub.href} class="view-all-link">
                      {sub.name} →
                    </a>
                  ))}
                </div>
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>

    <button class="mobile-toggle" aria-label="Menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mobile-menu">
    <nav>
      {items.map((item) => (
        <div class="mobile-nav-group">
          <a href={item.href} class:list={['mobile-link', { active: currentPath === item.href }]}>
            {item.label}
          </a>
          {item.submenu && (
            <div class="mobile-submenu">
              {item.submenu.filter(sub => !sub.highlight).map(sub => (
                <a href={sub.href} class="mobile-sub-link">
                  {sub.name}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(254, 253, 251, 0.72);
    backdrop-filter: blur(24px) saturate(1.8);
    -webkit-backdrop-filter: blur(24px) saturate(1.8);
    border-bottom: 0.5px solid rgba(10, 9, 8, 0.06);
    transition: box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .site-header.scrolled {
    box-shadow: 0 1px 3rem rgba(10, 9, 8, 0.06);
  }

  .container {
    max-width: 90rem;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .logo {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--ink);
    text-decoration: none;
    transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .logo:hover {
    opacity: 0.7;
  }
  
  .logo:active {
    transform: scale(0.98);
  }

  .desktop-nav {
    display: none;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: flex;
    }
  }

  .nav-item-wrapper {
    position: relative;
  }

  .nav-link {
    font-size: 0.9375rem;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: all 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    display: block;
    padding: 0.5rem 0;
  }

  .nav-link:hover {
    opacity: 0.6;
    transform: scale(1.01);
  }

  .nav-link.active {
    font-weight: 500;
  }

  /* Mega Dropdown */
  .mega-dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    background: rgba(254, 253, 251, 0.98);
    backdrop-filter: blur(32px);
    border-top: 0.5px solid rgba(10, 9, 8, 0.06);
    box-shadow: 0 1rem 3rem rgba(10, 9, 8, 0.08);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), 
                visibility 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .nav-item-wrapper:hover .mega-dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
  }

  .submenu-content {
    padding: 3rem 0;
  }

  .submenu-title {
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }

  .brands-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem 3rem;
    margin-bottom: 2rem;
  }

  .brand-link {
    font-size: 1.125rem;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: -0.01em;
    transition: all 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    display: block;
    padding: 0.75rem 0;
  }

  .brand-link:hover {
    transform: translateX(0.5rem);
    opacity: 0.7;
  }

  .view-all-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--wine);
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: all 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    display: inline-block;
    margin-top: 1rem;
  }

  .view-all-link:hover {
    transform: translateX(0.25rem);
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  @media (min-width: 768px) {
    .mobile-toggle {
      display: none;
    }
  }

  .mobile-toggle span {
    width: 1.5rem;
    height: 0.0625rem;
    background: var(--ink);
    transition: all 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-toggle:hover span {
    background: var(--wine);
  }

  /* Mobile Menu */
  .mobile-menu {
    position: fixed;
    top: 4rem;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(10, 9, 8, 0.98);
    backdrop-filter: blur(32px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-menu.active {
    opacity: 1;
    visibility: visible;
  }

  .mobile-menu nav {
    padding: 2rem;
  }

  .mobile-nav-group {
    margin-bottom: 1.5rem;
  }

  .mobile-link {
    display: block;
    font-size: 1.5rem;
    color: var(--paper);
    text-decoration: none;
    letter-spacing: -0.01em;
    padding: 0.75rem 0;
    transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-link:hover {
    transform: translateX(0.5rem);
    opacity: 0.7;
  }

  .mobile-link.active {
    color: var(--wine);
  }

  .mobile-submenu {
    margin-top: 0.5rem;
    padding-left: 1rem;
  }

  .mobile-sub-link {
    display: block;
    font-size: 1.125rem;
    color: rgba(254, 253, 251, 0.7);
    text-decoration: none;
    padding: 0.5rem 0;
    transition: all 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-sub-link:hover {
    color: var(--paper);
    transform: translateX(0.5rem);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const header = document.querySelector('.site-header');
    const toggle = document.querySelector('.mobile-toggle');
    const menu = document.querySelector('.mobile-menu');
    
    // Scroll effect for header shadow
    let lastScroll = 0;
    window.addEventListener('scroll', () => {
      const currentScroll = window.scrollY;
      if (currentScroll > 100) {
        header?.classList.add('scrolled');
      } else {
        header?.classList.remove('scrolled');
      }
      lastScroll = currentScroll;
    });

    // Mobile menu toggle
    toggle?.addEventListener('click', () => {
      menu?.classList.toggle('active');
      toggle.classList.toggle('active');
    });
  });
</script>
