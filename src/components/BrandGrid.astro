---
import { brands } from '../data/brands';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<div class="brand-grid">
  {brands.map((brand, index) => (
    <a class="brand-card" href={`/fr/marques/${brand.slug}`} data-reveal style={`--brand-tone:${brand.tone};${compact ? 'min-height:22rem' : ''}`}>
      <div class="brand-card-top"><span>0{index + 1}</span><span>{brand.category}</span></div>
      <div><h2>{brand.name}</h2><p>{brand.tagline}</p></div>
    </a>
  ))}
</div>
