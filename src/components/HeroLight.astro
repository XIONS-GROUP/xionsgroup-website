---
import { heroLightDefaults } from '../config/hero-light';
---
<div class="hero-light" data-hero-light data-paused="false">
  <div class="light-art" aria-hidden="true">
    <img class="light-poster" src="/images/home/xionsgroup-hero-light.svg" alt="" width="2876" height="1580" fetchpriority="high" />
    <canvas></canvas>
  </div>
  <button class="light-toggle" type="button" hidden>
    <svg class="pause-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M5 3v10M11 3v10" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
    <svg class="play-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="m5 3 8 5-8 5Z" fill="none" stroke="currentColor" /></svg>
    <span class="pause-label">Mettre l’animation en pause</span>
    <span class="play-label">Reprendre l’animation</span>
  </button>
  {import.meta.env.DEV && <details class="noise-controls" data-noise-controls hidden>
    <summary>Réglages du grain</summary>
    <label for="hero-grain-amount">Intensité du grain <output data-amount-value>{heroLightDefaults.grainAmount * 100}%</output></label><input id="hero-grain-amount" data-grain-amount type="range" min="0" max="100" value={heroLightDefaults.grainAmount * 100} step="1" />
    <label for="hero-grain-size">Taille du grain <output data-size-value>{heroLightDefaults.grainSize.toFixed(1)} px</output></label><input id="hero-grain-size" data-grain-size type="range" min="0.5" max="4" value={heroLightDefaults.grainSize} step="0.1" />
    <button type="button" class="replay-intro" data-replay-intro>Rejouer l’introduction</button>
    <p>Prévisualisation locale · réglages mémorisés dans ce navigateur.</p>
  </details>}
</div>
<script>
  import { initHeroLight } from '../scripts/hero-light';
  document.querySelectorAll<HTMLElement>('[data-hero-light]').forEach(initHeroLight);
</script>
<style>
  .hero-light,.light-art,.light-art canvas { position:absolute; inset:0; width:100%; height:100%; }
  .hero-light { --x-art-height:clamp(44rem,100svh,64rem); background:#090909; }
  .light-art { pointer-events:none; overflow:hidden; }
  .light-poster { position:absolute; top:50%; left:50%; height:var(--x-art-height); width:auto; aspect-ratio:2876 / 1580; max-width:none; transform:translate(-50%,-50%); }
  canvas { opacity:0; }
  [data-ready="true"] canvas { opacity:1; }
  .light-toggle { position:absolute; z-index:3; right:var(--pad); bottom:6.8rem; display:flex; align-items:center; gap:.6rem; min-height:44px; padding:.5rem .75rem; border:1px solid #ffffff40; border-radius:0; background:#09090999; color:#fff; cursor:pointer; font-size:.62rem; }
  .light-toggle[hidden],.play-icon,.play-label { display:none; }
  [data-paused="true"] .pause-icon,[data-paused="true"] .pause-label { display:none; }
  [data-paused="true"] .play-icon,[data-paused="true"] .play-label { display:block; }
  .light-toggle:hover { border-color:#ffffff99; }
  .noise-controls { position:absolute; z-index:4; right:var(--pad); top:calc(var(--header) + 1rem); width:min(18rem,calc(100% - 2 * var(--pad))); padding:.8rem 1rem; color:white; background:#111e; border:1px solid #ffffff40; font-size:.75rem; }
  .noise-controls[hidden] { display:none; }
  summary { cursor:pointer; }
  label { display:block; margin-top:1rem; } output { float:right; }
  input { display:block; width:100%; margin-top:.75rem; accent-color:white; }
  .noise-controls p { font-size:.65rem; opacity:.65; margin-bottom:0; }
  .replay-intro { margin-top:1rem; border:1px solid #ffffff55; background:transparent; color:inherit; padding:.5rem .7rem; cursor:pointer; }
  @media(max-width:700px) { .hero-light { --x-art-height:40rem; } }
</style>
