---
import { heroLightDefaults } from '../config/hero-light';
---
<div class="hero-light" data-hero-light data-paused="false" style={`--mobile-x-height:${heroLightDefaults.mobileXHeight}px`}>
  <div class="light-art" aria-hidden="true">
    <img class="light-poster" src="/images/home/xionsgroup-hero-light.svg" alt="" width="2876" height="1580" fetchpriority="high" />
    <canvas></canvas>
  </div>
  <button class="light-toggle" type="button" hidden>
    <svg class="pause-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M5 3v10M11 3v10" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
    <svg class="play-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="m5 3 8 5-8 5Z" fill="none" stroke="currentColor" /></svg>
    <span class="pause-label">Mettre l’animation en pause</span>
    <span class="play-label">Reprendre l’animation</span>
  </button>

</div>
<script>
  import { initHeroLight } from '../scripts/hero-light';
  document.querySelectorAll<HTMLElement>('[data-hero-light]').forEach(initHeroLight);
</script>
<style>
  .hero-light,.light-art,.light-art canvas { position:absolute; inset:0; width:100%; height:100%; }
  .hero-light { --x-art-height:clamp(44rem,100svh,64rem); background:#090909; }
  .light-art { pointer-events:none; overflow:hidden; }
  .light-poster { position:absolute; top:50%; left:50%; height:var(--x-art-height); width:auto; aspect-ratio:2876 / 1580; max-width:none; transform:translate(-50%,-50%); }
  canvas { opacity:0; }
  [data-ready="true"] canvas { opacity:1; }
  .light-toggle { position:absolute; z-index:3; right:var(--pad); bottom:6.8rem; display:flex; align-items:center; justify-content:center; width:44px; height:44px; padding:0; border:1px solid #ffffff40; border-radius:0; background:#09090999; color:#fff; cursor:pointer; font-size:.62rem; }
  .light-toggle[hidden],.play-icon,.play-label { display:none; }
  [data-paused="true"] .pause-icon,[data-paused="true"] .pause-label { display:none; }
  [data-paused="true"] .play-icon,[data-paused="true"] .play-label { display:block; }
  .pause-label,.play-label { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; }
  .light-toggle:hover { border-color:#ffffff99; }
  @media(max-width:700px) { .hero-light { --x-art-height:var(--mobile-x-height); } }
</style>
