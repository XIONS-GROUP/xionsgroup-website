---
import Arrow from './Arrow.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import BrandGrid from './BrandGrid.astro';
import VisualSlot from './VisualSlot.astro';
import visuals from '../data/visuals.json';
import { visualPreview } from '../config/visual-preview';
import { eventMarks } from '../data/rayonnement';
const desktop = visuals.find(v => v.id === 'home-desktop')!;
const mobile = visuals.find(v => v.id === 'home-mobile')!;
---
<SiteLayout title="XIONS GROUP — Imaginer la beauté de demain" description="Groupe français indépendant dédié à la création et au rayonnement de marques de beauté nouvelle génération.">
  <header class:list={['home-hero', {'has-image':!!desktop.src}]}>
    <div class="hero-media">
      {desktop.src ? <picture><source media="(max-width:700px)" srcset={mobile.src || desktop.src} /><img src={desktop.src} alt={desktop.alt} width={desktop.width} height={desktop.height} fetchpriority="high" /></picture> : <><div class="desktop-media"><VisualSlot id="home-desktop" bleed eager /></div><div class="mobile-media"><VisualSlot id="home-mobile" bleed eager /></div></>}
    </div>
    <div class="hero-content">
      <p class="eyebrow">Groupe de beauté indépendant · Paris</p>
      <h1 class="display">Imaginer<br /><em>la beauté</em><br />de demain.</h1>
      <div class="hero-foot"><p>Création · Science · Culture</p><a href="#vision">Découvrir <Arrow direction="down" /></a></div>
    </div>
    {visualPreview && <div class="hero-spec"><span class="desktop-spec">2560 × 1440 · fond recadré à l’écran</span><span class="mobile-spec">1440 × 3120 · plein écran · recadrage adaptable</span></div>}
  </header>
  <section class="section" id="vision"><div class="measure split"><p class="eyebrow">Notre vision</p><div class="prose"><h2 class="title-lg">Créer des maisons capables de redéfinir leur catégorie.</h2><p>XIONS Group est un groupe français indépendant qui crée, développe et déploie des marques de beauté premium à l'international.</p><p>Chaque maison possède son territoire, son langage et sa vision. Toutes partagent une même ambition : inventer de nouveaux standards.</p><a class="text-link" href="/fr/groupe">Découvrir le Groupe <Arrow /></a></div></div></section>
  <section class="brand-section"><div class="section measure section-head"><p class="eyebrow">Le portefeuille</p><h2 class="title-xl">Quatre maisons.<br />Quatre regards.</h2></div><BrandGrid compact /></section>
  <section class="section awards-section"><div class="measure"><p class="eyebrow">Présence internationale</p><h2 class="title-lg" style="margin-block:2rem">Au cœur des grands rendez-vous internationaux.</h2><p class="body-copy">Les marques de Xions Group s’inscrivent dans les grands rendez-vous de la culture, du cinéma, de la musique, de la mode et du divertissement.</p><div class="awards-grid">{eventMarks.map(mark=><div class="award-logo"><img src={mark.src} alt={mark.name} width="200" height="60" loading="lazy" /></div>)}</div><p class="awards-caption">Cannes · Paris · Los Angeles · Hollywood · New York · Londres</p><a class="text-link" href="/fr/presse">Explorer le rayonnement <Arrow /></a></div></section>
  <section class="section section-rule"><div class="measure"><div class="section-head"><p class="eyebrow">Notre rôle</p><h2 class="title-lg">De l'idée au rayonnement.</h2></div><div class="numbered-list"><div class="numbered-item"><span class="num">01</span><h3>Imaginer</h3><p>Vision entrepreneuriale, stratégie de marque et direction créative.</p></div><div class="numbered-item"><span class="num">02</span><h3>Développer</h3><p>Innovation produit, expertise opérationnelle et construction des marchés.</p></div><div class="numbered-item"><span class="num">03</span><h3>Rayonner</h3><p>Communication, culture et déploiement international.</p></div></div></div></section>
</SiteLayout>
<style>
  .home-hero { position:relative; min-height:100svh; background:white; padding:calc(var(--header) + 2rem) var(--pad) 3.5rem; display:flex; }
  .hero-media { position:absolute; inset:0; overflow:hidden; }
  .desktop-media,.mobile-media,picture { height:100%; width:100%; }
  .mobile-media,.mobile-spec { display:none; }
  picture img { width:100%; height:100%; object-fit:cover; object-position:center; }
  .hero-content { position:relative; z-index:1; width:100%; display:flex; flex-direction:column; justify-content:space-between; gap:2.5rem; pointer-events:none; }
  .hero-content a { pointer-events:auto; }
  .display { font-size:clamp(3.5rem,8vw,7.5rem); line-height:1; } em { color:var(--wine); font-weight:400; }
  .hero-foot { display:flex; justify-content:space-between; align-items:center; gap:1rem; font-size:.75rem; } .hero-foot p { margin:0; } .hero-foot a { text-decoration:none; }
  .hero-spec { position:absolute; bottom:.75rem; left:var(--pad); font-size:.6rem; color:#555; z-index:2; }
  .has-image { color:white; } .has-image em { color:inherit; }
  .has-image .hero-media::after { content:''; position:absolute; inset:0; background:linear-gradient(90deg,#0009,#0002); } .has-image .hero-spec { color:white; }
  .hero-media :global(.visual-copy) { align-self:flex-end; max-width:38%; margin-right:2rem; }
  .hero-media :global(.visual-index),.hero-media :global(.visual-note) { visibility:hidden; }
  .section-head { display:flex; justify-content:space-between; gap:2rem; }
  .section-rule .section-head { align-items:flex-start; margin-bottom:clamp(2.5rem,5vw,4rem); }
  .section-rule .section-head .title-lg { max-width:15ch; line-height:1.08; }
  .awards-section .title-lg { max-width:20ch; line-height:1.08; }
  .awards-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:2.5rem 3rem; margin:3.5rem 0 2.5rem; }
  .award-logo { display:flex; align-items:center; justify-content:center; min-height:clamp(7rem,11vw,10rem); }
  .award-logo img { width:min(100%,17rem); height:auto; aspect-ratio:3 / 2; object-fit:contain; }
  .awards-caption { font-size:.75rem; color:var(--muted); margin-bottom:2rem; }
  @media(max-width:700px) {
    .desktop-media,.desktop-spec { display:none; } .mobile-media,.mobile-spec { display:block; }
    .home-hero { min-height:100svh; padding-top:calc(var(--header) + 1.5rem); }
    .display { font-size:clamp(3rem,15vw,5.5rem); }
    .hero-media :global(.visual-copy) { position:absolute; right:var(--pad); bottom:7rem; max-width:75%; margin:0; text-align:right; }
    .hero-media :global(.visual-copy strong) { font-size:.8rem; }
    .section-head { flex-direction:column; }
    .awards-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.75rem 1.5rem; }
    .award-logo { min-height:7rem; }
  }
</style>
