---
import Arrow from './Arrow.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import BrandGrid from './BrandGrid.astro';
import HeroLight from './HeroLight.astro';
import { eventMarks } from '../data/rayonnement';
---
<SiteLayout title="XIONS GROUP — Imaginer la beauté de demain" description="Groupe français indépendant dédié à la création et au rayonnement de marques de beauté nouvelle génération.">
  <header class="home-hero has-image">
    <div class="hero-media">
      <HeroLight />
    </div>
    <div class="hero-content">
      <p class="hero-eyebrow">Groupe de beauté indépendant<br />Paris · Shanghai · Palm Beach</p>
      <h1 class="display"><span>Imaginer</span><em>la beauté</em><span>de demain.</span></h1>
      <div class="hero-foot">
        <p class="hero-sub">Création · Science · Culture</p>
        <a class="hero-scroll" href="#vision">Découvrir <Arrow direction="down" /></a>
      </div>
    </div>
  </header>
  <section class="section" id="vision"><div class="measure split"><p class="eyebrow">Notre vision</p><div class="prose"><h2 class="title-lg">Créer des maisons capables de redéfinir leur catégorie.</h2><p>XIONS Group est un groupe français indépendant qui crée, développe et déploie des marques de beauté premium à l’international.</p><p>Chaque maison possède son territoire, son langage et sa vision. Toutes partagent une même ambition : inventer de nouveaux standards.</p><a class="text-link" href="/fr/groupe/">Découvrir le Groupe <Arrow /></a></div></div></section>
  <section class="brand-section"><div class="section"><div class="measure brand-intro"><h2 class="title-lg">Quatre maisons.<br />Quatre regards.</h2><a class="text-link" href="/fr/marques/">Voir les marques <Arrow /></a></div></div><BrandGrid compact /></section>
  <section class="section awards-section"><div class="measure"><div class="section-head"><p class="eyebrow">Présence internationale</p><div><h2 class="title-lg">Au cœur des grands rendez-vous internationaux.</h2><p class="body-copy">Les marques de Xions Group s’inscrivent dans les grands rendez-vous de la culture, du cinéma, de la musique, de la mode et du divertissement.</p></div></div><ul class="event-index">{eventMarks.map(mark=><li class="event-item">{mark.name}</li>)}</ul><div class="awards-foot"><p class="awards-caption">Cannes · Paris · Los Angeles · Hollywood · New York · Londres</p><a class="text-link" href="/fr/presse/">Explorer le rayonnement <Arrow /></a></div></div></section>
  <section class="section section-rule role-section"><div class="measure"><div class="section-head"><p class="eyebrow">Notre rôle</p><h2 class="title-lg">De l’idée au rayonnement.</h2></div><div class="role-list">
    <article class="role-step" data-reveal><h3>Imaginer</h3><p>Nous partons d’une intuition et lui donnons une vision, un territoire et une direction créative.</p></article>
    <article class="role-step" data-reveal><h3>Développer</h3><p>Nous transformons cette vision en produits, en savoir-faire et en marchés.</p></article>
    <article class="role-step" data-reveal><h3>Rayonner</h3><p>Nous portons chaque maison dans la culture, les médias et les grandes capitales.</p></article>
  </div></div></section>
</SiteLayout>
<style>
  .home-hero { position:relative; min-height:max(44rem,100svh); background:#090909; padding:calc(var(--header) + 2rem) var(--pad) 3.5rem; display:flex; isolation:isolate; }
  .hero-media { position:absolute; inset:0; overflow:hidden; }
  /* Everything is centred, with the title sitting inside the X. The small lines are pushed to
     the top and bottom bands on purpose: difference blending cancels against mid grey, which is
     exactly the value of the X's waist, so thin type placed there disappears. The dark field
     above and below keeps them crisp. */
  .hero-content { position:relative; z-index:1; width:100%; display:grid; grid-template-rows:auto 1fr auto; justify-items:center; align-items:center; text-align:center; pointer-events:none; mix-blend-mode:difference; }
  .hero-content a { pointer-events:auto; }
  /* Readable floor: the eyebrow was at .68rem inherited from the global utility, which is fine
     beside body copy but not as standalone type over an animation. */
  .hero-eyebrow { margin:0; font-size:.82rem; line-height:1.75; font-weight:500; letter-spacing:.06em; }
  /* Desktop reads as one line spanning the hero — left, centre, right — sitting on the X's
     waist. Phones keep the three fragments stacked. */
  .display { align-self:center; justify-self:stretch; width:100%; max-width:none; display:grid;
    grid-template-columns:1fr auto 1fr; align-items:baseline; gap:clamp(2rem,6vw,7rem);
    font-size:clamp(1.7rem,3.6vw,2.9rem); line-height:1.04; letter-spacing:-.015em; }
  /* Equal outer tracks, so the middle fragment lands on the X's centre line rather than being
     pushed off it by the differing widths of the words either side. */
  .display > :first-child { justify-self:start; }
  .display > :last-child { justify-self:end; }
  em { color:var(--wine); font-weight:400; }
  .hero-foot { display:grid; justify-items:center; gap:1.1rem; }
  .hero-sub { margin:0; font-size:.72rem; letter-spacing:.14em; text-transform:uppercase; }
  .hero-scroll { display:inline-flex; align-items:center; gap:.6rem; font-size:.72rem; text-decoration:none; }
  .has-image { color:white; } .has-image em { color:inherit; }
  .counter { font-size:.72rem; letter-spacing:.06em; color:var(--muted); font-variant-numeric:tabular-nums; }
  /* Centred on the page. The "Nos marques" label repeated what the section already says, and
     the rule under the title added a division the centred composition does not need. */
  .brand-intro { display:grid; justify-items:center; gap:clamp(2rem,3.5vw,3rem); text-align:center; }
  .brand-intro .title-lg { max-width:14ch; line-height:1.02; }
  .awards-section,.role-section { padding-block:clamp(5rem,9vw,9.5rem); }
  /* One dark band breaks the run of four near-identical white sections, and carries the hero's
     X back into the page. The poster SVG is already dark-on-dark, so it needs no scrim. */
  .awards-section { position:relative; isolation:isolate; overflow:hidden; background:#0b0b0b; color:#f4f1ec; }
  .awards-section::before { content:''; position:absolute; z-index:-1; inset:0 -12% 0 auto; width:min(62%,54rem);
    background:url('/images/home/xionsgroup-hero-light.svg') center right / cover no-repeat; opacity:.85;
    mask-image:linear-gradient(to right,transparent,#000 48%); -webkit-mask-image:linear-gradient(to right,transparent,#000 48%);
    transform-origin:72% 50%; animation:awards-drift 26s var(--ease-luxury) infinite; }
  /* Slow, uneven breathing so the X reads as lit rather than looping. */
  @keyframes awards-drift {
    0%   { transform:scale(1) translate3d(0,0,0); opacity:.78; }
    38%  { transform:scale(1.07) translate3d(-1.2%,1.4%,0); opacity:.92; }
    64%  { transform:scale(1.03) translate3d(1.4%,-0.8%,0); opacity:.82; }
    100% { transform:scale(1) translate3d(0,0,0); opacity:.78; }
  }
  @media(prefers-reduced-motion:reduce) { .awards-section::before { animation:none; } }
  .awards-section .body-copy { color:#cdc7bf; }
  .awards-section .awards-caption { color:#8f8981; }
  .awards-section .section-head { margin-bottom:clamp(4rem,8vw,7rem); }
  .awards-section .title-lg { max-width:20ch; line-height:1.08; margin-bottom:2rem; }
  .event-index { list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:clamp(2.25rem,4vw,3.5rem) clamp(2rem,4vw,4rem); }
  .event-item { margin:0; font-family:var(--display); font-weight:400; font-size:clamp(1.5rem,2.4vw,2.2rem); line-height:1.05; letter-spacing:-.01em; }
  .awards-foot { display:flex; justify-content:space-between; align-items:baseline; gap:2rem; margin-top:clamp(4rem,8vw,7rem); }
  .awards-caption { margin:0; font-size:.75rem; color:var(--muted); }
  .role-section .section-head { align-items:flex-start; margin-bottom:clamp(4rem,8vw,7rem); }
  .role-section .section-head .title-lg { max-width:15ch; line-height:1.08; }
  /* Three equal boxes with 01/02/03 read like a table of contents. As rows — verb left,
     sentence right — it reads as a sequence, which is what the copy actually describes. */
  .role-list { display:grid; gap:clamp(2.5rem,4vw,3.5rem); }
  .role-step { display:grid; grid-template-columns:minmax(0,.9fr) minmax(0,1.6fr); gap:clamp(1.5rem,5vw,5rem); align-items:baseline; }
  .role-step h3 { margin:0; font-family:var(--display); font-weight:400; font-size:clamp(2.1rem,4vw,3.4rem); line-height:1; letter-spacing:-.02em; }
  .role-step p { margin:0; max-width:34rem; font-size:clamp(1rem,1.2vw,1.12rem); line-height:1.65; color:#514d46; }
  @media(max-width:700px) { .role-step { grid-template-columns:1fr; gap:.9rem; } }
  @media(max-width:900px) {
    .event-index { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .role-grid { grid-template-columns:1fr; gap:clamp(2.5rem,7vw,3.5rem); }
  }
  @media(max-width:700px) {
    /* Extra clearance so the eyebrow does not crowd the centred wordmark above it. */
    .home-hero { min-height:max(40rem,100svh); padding-top:calc(var(--header) + 3.25rem); }
    .display { grid-template-columns:1fr; justify-items:center; gap:0; justify-self:center; width:auto; font-size:30px; max-width:12ch; }
    .display > :first-child,.display > :last-child { justify-self:center; }
    /* Back to the pre-resize value on phones; only desktop needed the readability bump. */
    .hero-eyebrow { font-size:.68rem; line-height:1.7; }
    .hero-core { gap:1.1rem; }
    .brand-intro .title-lg { font-size:clamp(2.4rem,9.5vw,3.6rem); }
    .brand-intro-foot,.awards-foot { flex-direction:column; align-items:flex-start; gap:1.25rem; }
    .event-index { grid-template-columns:1fr; gap:1.25rem; }
  }
</style>
