---
import Arrow from './Arrow.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import VisualSlot from './VisualSlot.astro';
import visuals from '../data/visuals.json';
import { visualPreview } from '../config/visual-preview';
import type { brands } from '../data/brands';
type Brand = (typeof brands)[number];
interface Props { brand: Brand; index: number }
const { brand } = Astro.props;
const details = visuals.filter(v => v.id.startsWith(`${brand.slug}-detail`) && (v.src || visualPreview));
---
<SiteLayout title={`${brand.name} — XIONS GROUP`} description={brand.intro}>
  <header class="brand-heading shell measure"><p class="eyebrow">{brand.category}</p><h1>{brand.name}</h1><p>{brand.tagline}</p></header>
  <div class="shell"><div class="measure"><VisualSlot id={`${brand.slug}-hero`} eager /></div></div>
  <section class="section"><div class="measure split"><p class="eyebrow">La maison</p><div class="prose"><h2 class="title-md">{brand.intro}</h2>{brand.story.map(paragraph => <p>{paragraph}</p>)}</div></div></section>
  {details.length > 0 && <section class="detail-section shell"><div class:list={['measure','detail-grid',{'single-detail':details.length === 1}]}>{details.map(asset => <figure><VisualSlot id={asset.id} /><figcaption>{asset.label}</figcaption></figure>)}{details.length === 1 && <div class="detail-copy"><p class="eyebrow">La distinction</p><h2 class="title-md">Dorian’s Spleen</h2><p>{brand.pillars[2][1]}</p></div>}</div></section>}
  <section class="section"><div class="measure principle-grid">{brand.pillars.map(pillar => <div><h2>{pillar[0]}</h2><p>{pillar[1]}</p></div>)}</div></section>
  <div class="cta-band"><h2>Découvrir nos autres maisons</h2><a class="text-link" href="/fr/marques">Toutes les marques <Arrow /></a></div>
</SiteLayout>
<style>
  .brand-heading { padding-top:calc(var(--header) + 3rem); padding-bottom:2.5rem; text-align:center; }
  .brand-heading h1 { font:400 clamp(3rem,7vw,6rem)/1.1 var(--display); margin:1rem 0; }
  .brand-heading>p:last-child { max-width:40rem; margin:1rem auto 0; }
  .prose h2 { margin-bottom:2rem; }
  .detail-grid { display:grid; grid-template-columns:1fr 1fr; gap:2rem; } figure { min-width:0; margin:0; }
  figcaption { font-size:.7rem; margin-top:1rem; color:var(--muted); }
  .detail-copy { align-self:center; padding:clamp(1rem,5vw,5rem); } .detail-copy h2 { margin-top:1rem; }
  .principle-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:2rem; border-top:1px solid var(--line); padding-top:2rem; }
  .principle-grid h2 { font-size:1rem; font-weight:500; } .principle-grid p { font-size:.9rem; color:var(--muted); }
  @media(max-width:700px) { .detail-grid,.principle-grid { grid-template-columns:1fr; } .detail-copy { padding:1rem 0; } .brand-heading { padding-top:calc(var(--header) + 2rem); } }
</style>
