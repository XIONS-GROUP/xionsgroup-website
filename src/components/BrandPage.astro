---
import SiteLayout from '../layouts/SiteLayout.astro';
import type { brands } from '../data/brands';
type Brand = (typeof brands)[number];
interface Props { brand: Brand; index: number }
const { brand, index } = Astro.props;
---
<SiteLayout title={`${brand.name} — XIONS GROUP`} description={brand.intro}>
  <header class="brand-hero" style={`--brand-tone:${brand.tone}`}>
    <div data-reveal><p class="eyebrow">0{index + 1} · {brand.category}</p><h1>{brand.name}</h1></div>
    <p class="brand-tagline" data-reveal>{brand.tagline}</p>
    <span>{brand.status}</span>
  </header>
  <section class="section"><div class="measure split"><p class="eyebrow">La maison</p><div class="prose" data-reveal><h2 class="title-lg">{brand.intro}</h2>{brand.story.map((paragraph) => <p>{paragraph}</p>)}</div></div></section>
  <section class="section section-rule"><div class="measure"><p class="eyebrow" style="margin-bottom:3rem">Principes</p><div class="numbered-list">{brand.pillars.map((pillar, i) => <div class="numbered-item" data-reveal><span class="num">0{i + 1}</span><h3>{pillar[0]}</h3><p>{pillar[1]}</p></div>)}</div></div></section>
  <aside class="quote-panel"><blockquote>« {brand.tagline} »</blockquote></aside>
  <div class="cta-band"><h2>Découvrir nos autres maisons</h2><a class="text-link" href="/fr/marques">Toutes les marques ↗</a></div>
</SiteLayout>
<style>
  .brand-hero { min-height:75svh; padding:calc(var(--header) + 3rem) var(--pad) 4rem; color:#f7f2e9; background:var(--brand-tone); display:grid; grid-template-rows:1fr auto; grid-template-columns:minmax(0,1.5fr) minmax(0,1fr); align-items:end; }
  .brand-hero h1 { margin:0; font-family:var(--display); font-size:clamp(3rem,7vw,7rem); font-weight:400; line-height:1.05; letter-spacing:-.03em; }
  .brand-hero .eyebrow { margin-bottom:2rem; } .brand-tagline { max-width:28rem; margin:0 0 1rem auto; font-family:var(--display); font-size:clamp(1.5rem,2.6vw,2.8rem); line-height:.95; }
  .brand-hero>span { grid-column:1/-1; padding-top:3rem; margin-top:3rem; border-top:1px solid rgba(255,255,255,.3); font-size:.68rem; text-transform:none; letter-spacing:.02em; }
  @media(max-width:800px){ .brand-hero { grid-template-columns:1fr; gap:4rem; } .brand-tagline { margin-left:0; } }
</style>
