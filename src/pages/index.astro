            <p class="brand-text">Une parfumerie de niche libre, audacieuse et affranchie des conventions.</p>
            <div class="brand-footer">
              <span class="brand-award">★ Fragrance Foundation Award 2026</span>
              <a href="/fr/marques/lentropiste" class="brand-link">DÉCOUVRIR →</a>
            </div>
          </div>
        </article>

        <!-- Brand 2: BETENOIR -->
        <article class="brand-item">
          <div class="brand-num">02</div>
          <div class="brand-visual">
            <img src="https://images.unsplash.com/photo-1617897903246-719242758050?w=1600&auto=format&fit=crop" alt="BETENOIR" loading="lazy">
          </div>
          <div class="brand-content">
            <span class="brand-cat">PARFUMERIE EXPÉRIMENTALE</span>
            <h3 class="brand-title">BETENOIR</h3>
            <p class="brand-text">Obscurité élégante et sillages énigmatiques.</p>
            <div class="brand-footer">
              <span class="brand-status">LANCEMENT 2026</span>
            </div>
          </div>
        </article>

        <!-- Brand 3: SUNLUTION -->
        <article class="brand-item">
          <div class="brand-num">03</div>
          <div class="brand-visual">
            <img src="https://images.unsplash.com/photo-1556228578-8c89e6adf883?w=1600&auto=format&fit=crop" alt="SUNLUTION" loading="lazy">
          </div>
          <div class="brand-content">
            <span class="brand-cat">COSMÉTIQUE & SCIENCE</span>
            <h3 class="brand-title">SUNLUTION</h3>
            <p class="brand-text">La science de la lumière au service de la régénération cellulaire.</p>
            <div class="brand-footer">
              <a href="/fr/marques/sunlution" class="brand-link">DÉCOUVRIR →</a>
            </div>
          </div>
        </article>

        <!-- Brand 4: MASQLY -->
        <article class="brand-item">
          <div class="brand-num">04</div>
          <div class="brand-visual">
            <img src="https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?w=1600&auto=format&fit=crop" alt="MASQLY" loading="lazy">
          </div>
          <div class="brand-content">
            <span class="brand-cat">BODY CARE & RITUELS</span>
            <h3 class="brand-title">MASQLY</h3>
            <p class="brand-text">Sublimer les zones oubliées du rituel de soin quotidien.</p>
            <div class="brand-footer">
              <a href="/fr/marques/masqly" class="brand-link">DÉCOUVRIR →</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 05 RECOGNITION / AWARDS -->
  <section class="awards">
    <div class="awards-container">
      <div class="awards-badge">RECOGNITION 2026</div>
      <h2 class="awards-headline">
        PARFUM DE NICHE DE L'ANNÉE
      </h2>
      <p class="awards-sub">
        Fragrance Foundation France Awards — <em>Dorian's Spleen</em> par L'Entropiste
      </p>
    </div>
  </section>

  <!-- 06 INTERNATIONAL RESONANCE -->
  <section class="resonance">
    <div class="resonance-container">
      <div class="section-header">
        <span class="section-label">RAYONNEMENT MONDIAL</span>
        <h2 class="section-title">PARIS • LOS ANGELES • HOLLYWOOD</h2>
      </div>

      <div class="resonance-grid">
        <div class="res-card res-card--wide">
          <img src="https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=1600&auto=format&fit=crop" alt="Oscars Hollywood" loading="lazy">
          <div class="res-overlay">
            <span>OSCARS 98TH EDITION — HOLLYWOOD</span>
          </div>
        </div>
        <div class="res-card">
          <img src="https://images.unsplash.com/photo-1529310399831-ed472b81d589?w=800&auto=format&fit=crop" alt="Cannes" loading="lazy">
          <div class="res-overlay">
            <span>FESTIVAL DE CANNES</span>
          </div>
        </div>
        <div class="res-card">
          <img src="https://images.unsplash.com/photo-1514320291840-2e0a9bf2a9ae?w=800&auto=format&fit=crop" alt="Grammys" loading="lazy">
          <div class="res-overlay">
            <span>GRAMMY AWARDS — LOS ANGELES</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 CAREERS & CREATION -->
  <section class="contact-cta">
    <div class="contact-cta-container">
      <span class="cta-label">REJOINDRE LE GROUPE</span>
      <h2 class="cta-title">BÂTIR CE QUI N'EXISTE PAS ENCORE.</h2>
      <div class="cta-actions">
        <a href="/fr/contact?type=careers" class="btn-primary">CARRIÈRES & TALENTS</a>
        <a href="/fr/contact?type=business" class="btn-secondary">CONTACT AFFAIRES</a>
      </div>
    </div>
  </section>

  <!-- 页脚 -->
  <Footer />

  <!-- 🛠️ 纯代码参数化流体 Canvas 逻辑脚本 (Procedural Liquid Mesh Shader Script) -->
  <script>
    const canvas = document.getElementById('fluidCanvas');
    const ctx = canvas?.getContext('2d');

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });

    let step = 0;

    function renderProceduralBackground() {
      if (!ctx) return;
      step += 0.003;

      // 绘制渐变柔和基底
      const baseGrad = ctx.createLinearGradient(0, 0, width, height);
      baseGrad.addColorStop(0, '#060608');
      baseGrad.addColorStop(0.5, '#0B0B0E');
      baseGrad.addColorStop(1, '#050506');
      ctx.fillStyle = baseGrad;
      ctx.fillRect(0, 0, width, height);

      // 参数化三角函数模拟高定流体物理暗影光芒 (Procedural wave light math)
      const x1 = width * 0.5 + Math.sin(step) * 200;
      const y1 = height * 0.2 + Math.cos(step * 0.8) * 120;
      const r1 = Math.min(width, height) * 0.6;

      const grad1 = ctx.createRadialGradient(x1, y1, 10, x1, y1, r1);
      grad1.addColorStop(0, 'rgba(255, 255, 255, 0.09)');
      grad1.addColorStop(0.4, 'rgba(180, 180, 200, 0.03)');
      grad1.addColorStop(1, 'rgba(0, 0, 0, 0)');

      ctx.fillStyle = grad1;
      ctx.beginPath();
      ctx.arc(x1, y1, r1, 0, Math.PI * 2);
      ctx.fill();

      // 第二层慢速移动的反向高微亮弧形
      const x2 = width * 0.7 - Math.cos(step * 0.6) * 250;
      const y2 = height * 0.75 + Math.sin(step * 0.7) * 150;
      const r2 = Math.min(width, height) * 0.7;

      const grad2 = ctx.createRadialGradient(x2, y2, 20, x2, y2, r2);
      grad2.addColorStop(0, 'rgba(220, 225, 240, 0.06)');
      grad2.addColorStop(0.5, 'rgba(40, 40, 50, 0.02)');
      grad2.addColorStop(1, 'rgba(0, 0, 0, 0)');

      ctx.fillStyle = grad2;
      ctx.beginPath();
      ctx.arc(x2, y2, r2, 0, Math.PI * 2);
      ctx.fill();

      requestAnimationFrame(renderProceduralBackground);
    }

    renderProceduralBackground();
  </script>
</body>
</html>

<style is:global>
  /* ==========================================================================
     PROCEDURAL LUXURY STYLING SYSTEM
     ========================================================================== */

  /* 动态 Canvas 背景 */
  .fluid-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -2;
    pointer-events: none;
  }

  /* 电影胶片噪点颗粒 */
  .grain-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: -1;
    opacity: 0.038;
    background: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }

  /* ==========================================================================
     01 HERO SECTION
     ========================================================================== */
  .hero {
    position: relative;
    height: 100vh;
    min-height: 700px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 0 60px;
    border-bottom: 0.5px solid rgba(255, 255, 255, 0.1);
  }

  .hero-content {
    text-align: center;
    max-width: 1100px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-tagline {
    font-size: 10px;
    letter-spacing: 0.35em;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 32px;
    text-transform: uppercase;
  }

  .hero-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(54px, 8vw, 116px);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: #FFFFFF;
    margin-bottom: 32px;
    display: flex;
    flex-direction: column;
  }

  .hero-line {
    background: linear-gradient(180deg, #FFFFFF 0%, rgba(240, 240, 240, 0.75) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-desc {
    font-size: 15px;
    font-weight: 300;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.65);
    max-width: 540px;
    line-height: 1.6;
  }

  .hero-footer-bar {
    position: absolute;
    bottom: 40px;
    left: 60px;
    right: 60px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hero-meta {
    display: flex;
    gap: 12px;
    font-size: 10px;
    letter-spacing: 0.25em;
    color: rgba(255, 255, 255, 0.45);
  }

  .hero-meta .sep {
    color: rgba(255, 255, 255, 0.2);
  }

  .hero-scroll-indicator {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 9px;
    letter-spacing: 0.25em;
    color: rgba(255, 255, 255, 0.5);
  }

  .scroll-line {
    width: 40px;
    height: 1px;
    background: rgba(255, 255, 255, 0.3);
  }

  /* ==========================================================================
     02 MANIFESTO SECTION
     ========================================================================== */
  .manifesto {
    padding: 180px 80px;
    border-bottom: 0.5px solid rgba(255, 255, 255, 0.08);
  }

  .manifesto-container {
    max-width: 1300px;
    margin: 0 auto;
  }

  .manifesto-header {
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    letter-spacing: 0.25em;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 80px;
  }

  .manifesto-quote h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(38px, 5vw, 76px);
    font-weight: 300;
    line-height: 1.08;
    color: #FFFFFF;
    margin-bottom: 80px;
  }

  .manifesto-quote em {
    font-style: italic;
    color: rgba(255, 255, 255, 0.65);
  }

  .manifesto-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
  }

  .manifesto-col p {
    font-size: 15px;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.65);
    font-weight: 300;
  }

  /* ==========================================================================
     03 FOUNDERS SECTION
     ========================================================================== */
  .founders {
    padding: 140px 80px;
    border-bottom: 0.5px solid rgba(255, 255, 255, 0.08);
  }

  .founders-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .section-label {
    font-size: 10px;
    letter-spacing: 0.3em;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 32px;
    display: block;
  }

  .founders-card {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .founders-image-wrapper {
    width: 100%;
    height: 650px;
    overflow: hidden;
    border-radius: 2px;
    border: 0.5px solid rgba(255, 255, 255, 0.12);
  }

  .founders-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.08);
    transition: all 0.8s ease;
  }

  .founders-image-wrapper:hover img {
    filter: grayscale(30%);
    transform: scale(1.02);
  }

  .founders-caption {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    padding-top: 16px;
  }

  .founder-person {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .founder-name {
    font-size: 12px;
    letter-spacing: 0.2em;
    color: #FFFFFF;
    font-weight: 500;
  }

  .founder-role {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.45);
    font-weight: 300;
  }

  /* ==========================================================================
     04 BRANDS PORTFOLIO SECTION
     ========================================================================== */
  .brands {
    padding: 160px 80px;
    border-bottom: 0.5px solid rgba(255, 255, 255, 0.08);
  }

  .brands-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 38px;
    font-weight: 300;
    color: #FFFFFF;
    margin-bottom: 80px;
  }

  .brands-list {
    display: flex;
    flex-direction: column;
    gap: 120px;
  }

  .brand-item {
    display: grid;
    grid-template-columns: 60px 1.2fr 1fr;
    gap: 60px;
    align-items: center;
    padding-top: 60px;
    border-top: 0.5px solid rgba(255, 255, 255, 0.1);
  }

  .brand-num {
    font-size: 13px;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.3);
  }

  .brand-visual {
    height: 520px;
    overflow: hidden;
    border-radius: 2px;
    border: 0.5px solid rgba(255, 255, 255, 0.1);
  }

  .brand-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(70%);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .brand-item:hover .brand-visual img {
    filter: grayscale(0%);
    transform: scale(1.03);
  }

  .brand-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .brand-cat {
    font-size: 10px;
    letter-spacing: 0.25em;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 16px;
  }

  .brand-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 48px;
    font-weight: 300;
    color: #FFFFFF;
    margin-bottom: 20px;
  }

  .brand-text {
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 40px;
    font-weight: 300;
  }

  .brand-footer {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .brand-award {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: #FFFFFF;
  }

  .brand-status {
    font-size: 11px;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.4);
  }

  .brand-link {
    font-size: 11px;
    letter-spacing: 0.25em;
    color: #FFFFFF;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .brand-link:hover {
    opacity: 0.6;
  }

  /* ==========================================================================
     05 AWARDS / RECOGNITION
     ========================================================================== */
  .awards {
    padding: 160px 80px;
    background: rgba(14, 14, 16, 0.6);
    border-bottom: 0.5px solid rgba(255, 255, 255, 0.08);
    text-align: center;
  }

  .awards-badge {
    font-size: 10px;
    letter-spacing: 0.3em;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 24px;
  }

  .awards-headline {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(36px, 5vw, 68px);
    font-weight: 300;
    color: #FFFFFF;
    margin-bottom: 20px;
  }

  .awards-sub {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.65);
    font-weight: 300;
  }

  /* ==========================================================================
     06 RESONANCE & 07 CONTACT CTA
     ========================================================================== */
  .resonance {
    padding: 160px 80px;
    border-bottom: 0.5px solid rgba(255, 255, 255, 0.08);
  }

  .resonance-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .resonance-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .res-card {
    position: relative;
    height: 380px;
    overflow: hidden;
    border-radius: 2px;
    border: 0.5px solid rgba(255, 255, 255, 0.1);
  }

  .res-card--wide {
    grid-column: span 3;
    height: 480px;
