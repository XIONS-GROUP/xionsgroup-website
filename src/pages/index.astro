---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { robotsDirective } from '../config/indexing';

const pageTitle = 'XIONS GROUP — Imaginer la beauté de demain';
const pageDescription = 'Un groupe français indépendant qui crée, développe et déploie des marques de beauté premium à l\'international.';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content={robotsDirective}>
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription}>
  
  <!-- Fonts - Grotesk Display -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>

<body>
  <!-- Navigation -->
  <Navigation />

  <!-- 01 HERO - Extreme minimal -->
  <section class="hero">
    <div class="hero-bg-video">
      <!-- 暂用静态图，后续替换为video -->
      <div class="hero-bg-placeholder"></div>
    </div>
    <div class="hero-content">
      <h1 class="hero-title">
        <span class="hero-line">IMAGINER</span>
        <span class="hero-line">LA BEAUTÉ</span>
        <span class="hero-line">DE DEMAIN.</span>
      </h1>
    </div>
  </section>

  <!-- 02 MANIFESTO -->
  <section class="manifesto">
    <div class="manifesto-container">
      <div class="manifesto-meta">
        <span>XIONS GROUP</span>
        <span>PARIS — 2026</span>
      </div>
      <div class="manifesto-statement">
        <h2>
          Nous ne créons pas<br>
          des marques pour suivre<br>
          les catégories.<br>
          <em>Nous les créons pour<br>
          les redéfinir.</em>
        </h2>
      </div>
      <div class="manifesto-body">
        <div class="manifesto-spacer"></div>
        <div class="manifesto-text">
          <p>
            XIONS GROUP est un groupe français indépendant qui crée, 
            développe et déploie des marques de beauté premium à 
            l'international.
          </p>
          <p>
            Chacune possède son propre territoire, son langage et 
            sa vision. Notre rôle est de leur donner les moyens 
            d'exister pleinement.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 FOUNDERS - Cinematic portrait -->
  <section class="founders">
    <div class="founders-image">
      <img src="https://images.unsplash.com/photo-1542744173-8e7e53415bb0?w=2000&auto=format&fit=crop&q=90" alt="Fondateurs" loading="lazy">
    </div>
    <div class="founders-credits">
      <span>DENIS BELLAÏCHE</span>
      <span>KRIS FANG</span>
      <span>NEO SU</span>
    </div>
  </section>

  <!-- 04 BRANDS - Full-screen chapters -->
  <section class="brands">
    <!-- Brand 01: L'ENTROPISTE -->
    <article class="brand-chapter brand-chapter--lentropiste">
      <div class="brand-number">01</div>
      <div class="brand-visual">
        <img src="https://images.unsplash.com/photo-1541643600914-78b084683601?w=2000&auto=format&fit=crop" alt="L'Entropiste" loading="lazy">
      </div>
      <div class="brand-info">
        <h3 class="brand-name">L'ENTROPISTE</h3>
        <p class="brand-category">PARFUMERIE</p>
        <p class="brand-description">
          Une parfumerie de niche<br>
          libre, audacieuse et inattendue.
        </p>
        <a href="/fr/brands/lentropiste" class="brand-cta">DISCOVER</a>
      </div>
    </article>

    <!-- Brand 02: BETENOIR -->
    <article class="brand-chapter brand-chapter--betenoir">
      <div class="brand-number">02</div>
      <div class="brand-visual">
        <img src="https://images.unsplash.com/photo-1617897903246-719242758050?w=2000&auto=format&fit=crop" alt="Betenoir" loading="lazy">
      </div>
      <div class="brand-info">
        <h3 class="brand-name">BETENOIR</h3>
        <p class="brand-category">PARFUMERIE</p>
        <p class="brand-status">COMING 2026</p>
      </div>
    </article>

    <!-- Brand 03: SUNLUTION -->
    <article class="brand-chapter brand-chapter--sunlution">
      <div class="brand-number">03</div>
      <div class="brand-visual">
        <img src="https://images.unsplash.com/photo-1556228578-8c89e6adf883?w=2000&auto=format&fit=crop" alt="Sunlution" loading="lazy">
      </div>
      <div class="brand-info">
        <h3 class="brand-name">SUNLUTION</h3>
        <p class="brand-category">COSMÉTIQUE / SCIENCE</p>
        <p class="brand-description">
          La science de la lumière<br>
          au service de la peau.
        </p>
        <a href="/fr/brands/sunlution" class="brand-cta">DISCOVER</a>
      </div>
    </article>

    <!-- Brand 04: MASQLY -->
    <article class="brand-chapter brand-chapter--masqly">
      <div class="brand-number">04</div>
      <div class="brand-visual">
        <img src="https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?w=2000&auto=format&fit=crop" alt="Masqly" loading="lazy">
      </div>
      <div class="brand-info">
        <h3 class="brand-name">MASQLY</h3>
        <p class="brand-category">COSMÉTIQUE / BODY CARE</p>
        <p class="brand-description">
          Les zones oubliées<br>
          du rituel beauté.
        </p>
        <a href="/fr/brands/masqly" class="brand-cta">DISCOVER</a>
      </div>
    </article>
  </section>

  <!-- 05 AWARD MOMENT - L'Entropiste highlight -->
  <section class="award-moment">
    <div class="award-container">
      <div class="award-label">RECOGNITION</div>
      <h2 class="award-title">
        AWARD WINNING<br>
        NICHE PERFUMERY
      </h2>
      <div class="award-details">
        <div class="award-item">
          <span class="award-year">2026</span>
          <span class="award-name">Fragrance Foundation France</span>
          <span class="award-category">Parfum de niche de l'année</span>
        </div>
        <div class="award-product">
          <span>Dorian's Spleen</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 QUALITY - Compressed -->
  <section class="quality">
    <div class="quality-container">
      <div class="quality-label">OUR STANDARD</div>
      <div class="quality-keywords">
        <div class="quality-keyword">
          <h3>QUALITY</h3>
          <p>L'exigence de l'excellence</p>
        </div>
        <div class="quality-keyword">
          <h3>RESPONSIBILITY</h3>
          <p>Transparence et éthique</p>
        </div>
        <div class="quality-keyword">
          <h3>PROGRESS</h3>
          <p>Innovation durable</p>
        </div>
      </div>
      <a href="/fr/impact" class="quality-link">Discover our commitments</a>
    </div>
  </section>

  <!-- 07 INTERNATIONAL - Archive style -->
  <section class="international">
    <div class="international-header">
      <h2>FRENCH BRANDS.<br>GLOBAL RESONANCE.</h2>
    </div>
    <div class="international-grid">
      <!-- Large feature -->
      <div class="intl-item intl-item--large">
        <img src="https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=1400&auto=format&fit=crop" alt="Oscars" loading="lazy">
        <div class="intl-info">
          <span class="intl-event">OSCARS</span>
          <span class="intl-location">HOLLYWOOD</span>
          <span class="intl-year">2026</span>
        </div>
      </div>

      <!-- Medium items -->
      <div class="intl-item intl-item--medium">
        <img src="https://images.unsplash.com/photo-1529310399831-ed472b81d589?w=800&auto=format&fit=crop" alt="Cannes" loading="lazy">
        <div class="intl-info">
          <span class="intl-event">CANNES</span>
          <span class="intl-location">FRANCE</span>
        </div>
      </div>

      <div class="intl-item intl-item--medium">
        <img src="https://images.unsplash.com/photo-1514320291840-2e0a9bf2a9ae?w=800&auto=format&fit=crop" alt="Grammy" loading="lazy">
        <div class="intl-info">
          <span class="intl-event">GRAMMYS</span>
          <span class="intl-location">LOS ANGELES</span>
        </div>
      </div>

      <!-- Small items -->
      <div class="intl-item intl-item--small">
        <img src="https://images.unsplash.com/photo-1556228453-efd6c1ff04f6?w=600&auto=format&fit=crop" alt="Paris OOH" loading="lazy">
        <div class="intl-info">
          <span class="intl-event">PARIS OOH</span>
        </div>
      </div>

      <div class="intl-item intl-item--small">
        <img src="https://images.unsplash.com/photo-1551818255-e6e10975bc17?w=600&auto=format&fit=crop" alt="London" loading="lazy">
        <div class="intl-info">
          <span class="intl-event">LONDON</span>
        </div>
      </div>

      <div class="intl-item intl-item--small">
        <img src="https://images.unsplash.com/photo-1515377905703-c4788e51af15?w=600&auto=format&fit=crop" alt="New York" loading="lazy">
        <div class="intl-info">
          <span class="intl-event">NEW YORK</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 08 MEDIA - Masonry grid -->
  <section class="media">
    <div class="media-container">
      <div class="media-header">
        <h2>SELECTED MOMENTS</h2>
        <span>2026</span>
      </div>
      <div class="media-grid">
        <div class="media-item media-item--tall">
          <img src="https://images.unsplash.com/photo-1556228578-8c89e6adf883?w=600&auto=format&fit=crop" alt="Campaign" loading="lazy">
          <div class="media-caption">
            <span class="media-number">01</span>
            <span class="media-title">CANNES</span>
          </div>
        </div>
        <div class="media-item">
          <img src="https://images.unsplash.com/photo-1541643600914-78b084683601?w=600&auto=format&fit=crop" alt="Campaign" loading="lazy">
          <div class="media-caption">
            <span class="media-number">02</span>
            <span class="media-title">PARIS OOH</span>
          </div>
        </div>
        <div class="media-item">
          <img src="https://images.unsplash.com/photo-1515377905703-c4788e51af15?w=600&auto=format&fit=crop" alt="Campaign" loading="lazy">
          <div class="media-caption">
            <span class="media-number">03</span>
            <span class="media-title">MADAME FIGARO</span>
          </div>
        </div>
        <div class="media-item media-item--wide">
          <img src="https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=1200&auto=format&fit=crop" alt="Campaign" loading="lazy">
          <div class="media-caption">
            <span class="media-number">04</span>
            <span class="media-title">HOLLYWOOD</span>
          </div>
        </div>
        <div class="media-item">
          <img src="https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?w=600&auto=format&fit=crop" alt="Campaign" loading="lazy">
          <div class="media-caption">
            <span class="media-number">05</span>
            <span class="media-title">SOCIAL</span>
          </div>
        </div>
        <div class="media-item">
          <img src="https://images.unsplash.com/photo-1529310399831-ed472b81d589?w=600&auto=format&fit=crop" alt="Campaign" loading="lazy">
          <div class="media-caption">
            <span class="media-number">06</span>
            <span class="media-title">LA</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 09 CAREERS - Minimal -->
  <section class="careers">
    <div class="careers-container">
      <h2 class="careers-title">
        BUILD WHAT<br>
        DOESN'T EXIST YET.
      </h2>
      <div class="careers-roles">
        <span>Création</span>
        <span>Marketing</span>
        <span>Digital</span>
        <span>Product</span>
        <span>Communication</span>
        <span>Operations</span>
      </div>
      <a href="/fr/careers" class="careers-cta">VIEW OPEN POSITIONS</a>
    </div>
  </section>

  <!-- 10 CONTACT - Grand finale -->
  <section class="contact-finale">
    <div class="contact-container">
      <h2 class="contact-title">
        LET'S CREATE<br>
        WHAT COMES NEXT.
      </h2>
      <div class="contact-options">
        <a href="/fr/contact?type=general" class="contact-option">PARIS</a>
        <a href="/fr/contact?type=press" class="contact-option">PRESS</a>
        <a href="/fr/contact?type=business" class="contact-option">BUSINESS</a>
        <a href="/fr/careers" class="contact-option">CAREERS</a>
        <a href="/fr/contact?type=partnerships" class="contact-option">PARTNERSHIPS</a>
      </div>
    </div>
  </section>

  <Footer />
</body>
</html>

<style is:global>
  /* Reset & Base */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    color: #0A0A0A;
    background: #FFFFFF;
    overflow-x: hidden;
  }

  /* ================================
     NAVIGATION - Minimal fixed
     ================================ */

  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 32px 48px;
    background: rgba(255, 255, 255, 0);
    transition: background 0.3s ease;
  }

  .nav.scrolled {
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(10px);
  }

  .nav-logo {
    font-size: 11px;
    letter-spacing: 0.15em;
    font-weight: 500;
    color: #0A0A0A;
    text-decoration: none;
  }

  .nav-right {
    display: flex;
    gap: 40px;
  }

  .nav-link {
    font-size: 11px;
    letter-spacing: 0.1em;
    font-weight: 400;
    color: #0A0A0A;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 0.3s ease;
  }

  .nav-link:hover {
    opacity: 0.5;
  }

  /* ================================
     01 HERO - Extreme minimal
     ================================ */

  .hero {
    position: relative;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-bg-video {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #F5F5F5 0%, #E8E8E8 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 48px;
  }

  .hero-title {
    font-size: clamp(80px, 15vw, 180px);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 0.9;
    color: #0A0A0A;
  }

  .hero-line {
    display: block;
    opacity: 0;
    animation: heroReveal 1.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-line:nth-child(1) { animation-delay: 0.1s; }
  .hero-line:nth-child(2) { animation-delay: 0.3s; }
  .hero-line:nth-child(3) { animation-delay: 0.5s; }

  @keyframes heroReveal {
    from {
      opacity: 0;
      transform: translateY(100px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ================================
     02 MANIFESTO
     ================================ */

  .manifesto {
    padding: 160px 48px;
    background: #FFFFFF;
  }

  .manifesto-container {
    max-width: 1600px;
    margin: 0 auto;
  }

  .manifesto-meta {
    display: flex;
    gap: 40px;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #999999;
    margin-bottom: 120px;
  }

  .manifesto-statement {
    margin-bottom: 160px;
  }

  .manifesto-statement h2 {
    font-size: clamp(48px, 8vw, 96px);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: #0A0A0A;
  }

  .manifesto-statement em {
    font-style: italic;
    font-weight: 400;
  }

  .manifesto-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
  }

  .manifesto-spacer {
    /* Left column empty - editorial layout */
  }

  .manifesto-text {
    font-size: 18px;
    line-height: 1.7;
    color: #0A0A0A;
  }

  .manifesto-text p {
    margin-bottom: 24px;
  }

  /* ================================
     03 FOUNDERS - Cinematic
     ================================ */

  .founders {
    position: relative;
    padding: 0;
  }

  .founders-image {
    width: 100%;
    height: 70vh;
    overflow: hidden;
  }

  .founders-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.3);
  }

  .founders-credits {
    display: flex;
    justify-content: center;
    gap: 80px;
    padding: 48px;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #666666;
  }

  /* ================================
     04 BRANDS - Full-screen chapters
     ================================ */

  .brands {
    background: #000000;
  }

  .brand-chapter {
    position: relative;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .brand-number {
    position: absolute;
    top: 48px;
    left: 48px;
    font-size: 12px;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.3);
    z-index: 3;
  }

  .brand-visual {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .brand-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.6;
    transition: opacity 0.8s ease, transform 2s ease;
  }

  .brand-chapter:hover .brand-visual img {
    opacity: 0.8;
    transform: scale(1.05);
  }

  .brand-info {
    position: relative;
    z-index: 2;
    text-align: center;
    color: #FFFFFF;
  }

  .brand-name {
    font-size: clamp(60px, 10vw, 120px);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1;
    margin-bottom: 16px;
  }

  .brand-category {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: 48px;
  }

  .brand-description {
    font-size: 18px;
    line-height: 1.6;
    margin-bottom: 48px;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .brand-chapter:hover .brand-description {
    opacity: 1;
    transform: translateY(0);
  }

  .brand-status {
    font-size: 12px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.5;
  }

  .brand-cta {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #FFFFFF;
    text-decoration: none;
    padding: 16px 48px;
    border: 0.5px solid rgba(255, 255, 255, 0.3);
    transition: all 0.4s ease;
  }

  .brand-cta:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.6);
  }

  /* Brand-specific colors */
  .brand-chapter--betenoir {
    background: #000000;
  }

  .brand-chapter--betenoir .brand-visual img {
    opacity: 0.4;
  }

  .brand-chapter--sunlution {
    background: #FAFAFA;
  }

  .brand-chapter--sunlution .brand-info {
    color: #0A0A0A;
  }

  .brand-chapter--sunlution .brand-cta {
    color: #0A0A0A;
    border-color: rgba(10, 10, 10, 0.3);
  }

  .brand-chapter--sunlution .brand-cta:hover {
    background: rgba(10, 10, 10, 0.05);
    border-color: rgba(10, 10, 10, 0.6);
  }

  /* ================================
     05 AWARD MOMENT
     ================================ */

  .award-moment {
    padding: 200px 48px;
    background: #0A0A0A;
    color: #FFFFFF;
    text-align: center;
  }

  .award-label {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.5;
    margin-bottom: 48px;
  }

  .award-title {
    font-size: clamp(48px, 8vw, 96px);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 80px;
  }

  .award-details {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    font-size: 16px;
    line-height: 1.6;
  }

  .award-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .award-year {
    font-size: 12px;
    letter-spacing: 0.1em;
    opacity: 0.5;
  }

  .award-name {
    font-size: 18px;
    font-weight: 500;
  }

  .award-category {
    font-size: 14px;
    opacity: 0.7;
  }

  .award-product {
    font-size: 14px;
    font-style: italic;
    opacity: 0.6;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .nav {
      padding: 24px 32px;
    }

    .manifesto-body {
      grid-template-columns: 1fr;
    }

    .manifesto-spacer {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .nav-right {
      display: none;
    }

    .manifesto {
      padding: 100px 24px;
    }

    .manifesto-meta {
      flex-direction: column;
      gap: 8px;
      margin-bottom: 80px;
    }

    .manifesto-statement {
      margin-bottom: 100px;
    }

    .founders-credits {
      flex-direction: column;
      gap: 16px;
      text-align: center;
    }

