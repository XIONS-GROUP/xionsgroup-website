    <div class="hero-footer-bar">
      <div class="hero-meta">
        <span>PARIS</span>
        <span class="sep">•</span>
        <span>HAUTE PARFUMERIE</span>
        <span class="sep">•</span>
        <span>2026</span>
      </div>
      <div class="hero-scroll-indicator">
        <span>DÉCOUVRIR</span>
