    <div class="brands-container">
      <div class="section-header">
        <span class="section-label">PORTFOLIO</span>
        <h2 class="section-title">NOS MAISONS DE BEAUTÉ</h2>
      </div>

      <div class="brands-list">
        <!-- Brand 1: L'ENTROPISTE -->
        <article class="brand-item">
          <div class="brand-num">01</div>
          <div class="brand-visual">
            <img src="https://images.unsplash.com/photo-1541643600914-78b084683601?w=1600&auto=format&fit=crop" alt="L'Entropiste" loading="lazy">
