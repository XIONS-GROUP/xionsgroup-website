    <div class="founders-container">
      <div class="section-header">
        <span class="section-label">DIRECTION & VISION</span>
      </div>
      <div class="founders-card">
        <div class="founders-image-wrapper">
          <img src="https://images.unsplash.com/photo-1542744173-8e7e53415bb0?w=2000&auto=format&fit=crop&q=90" alt="Fondateurs XIONS GROUP" loading="lazy">
        </div>
        <div class="founders-caption">
          <div class="founder-person">
            <span class="founder-name">DENIS BELLAÏCHE</span>
            <span class="founder-role">Vision Stratégique</span>
          </div>
          <div class="founder-person">
            <span class="founder-name">KRIS FANG</span>
            <span class="founder-role">Création & Innovation</span>
          </div>
          <div class="founder-person">
            <span class="founder-name">NEO SU</span>
            <span class="founder-role">Opérations & International</span>
          </div>
        </div>
