---
const pageTitle = "XIONS GROUP";
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>{pageTitle}</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #000;
    }
    .holding-container {
      position: relative;
      width: 100vw;
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      /* 弧形柔和渐变：顶部微白弧形光芒（带有弯曲弧度），向下平滑过渡至纯黑 */
      background: 
        radial-gradient(ellipse 160% 110% at 50% -35%, rgba(255, 255, 255, 0.28) 0%, rgba(50, 50, 50, 0.45) 35%, rgba(10, 10, 10, 0.95) 75%, rgba(0, 0, 0, 1) 100%);
    }
    .holding-logo-img {
      max-width: 320px;
      width: 75%;
      height: auto;
      object-fit: contain;
      filter: drop-shadow(0 0 25px rgba(255, 255, 255, 0.15));
      user-select: none;
    }
  </style>
</head>
<body>
  <div class="holding-container">
    <img class="holding-logo-img" src="/XIONS_Horizontal_White_LOGO.png" alt="XIONS GROUP" />
  </div>
</body>
</html>
