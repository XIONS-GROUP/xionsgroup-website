---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'XIONS GROUP — Imaginer la beauté de demain';
const pageDescription = 'Un groupe français indépendant qui crée, développe et déploie des marques de beauté premium à l\'international.';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription}>
  
  <!-- Fonts - Grotesk & Serif Display -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>

<body>
  <!-- 噪点颗粒全屏纹理遮罩 -->
  <div class="grain-overlay" aria-hidden="true"></div>

  <!-- 黑白流动渐变液态光晕背景 -->
  <div class="ambient-fluid-bg" aria-hidden="true">
    <div class="fluid-orb orb-1"></div>
    <div class="fluid-orb orb-2"></div>
    <div class="fluid-orb orb-3"></div>
  </div>

  <!-- 顶部导航 -->
  <Navigation />

  <!-- 01 HERO - 极简流体光影与黑黑/白极致视觉 -->
  <section class="hero">
    <div class="hero-bg">
      <div class="hero-gradient-mesh"></div>
    </div>
    <div class="hero-content">
      <div class="hero-logo-wrapper">
        <img src="/XIONS_LOGO.svg" alt="XIONS GROUP Logo" class="hero-logo-img" />
      </div>
      <h1 class="hero-title">
        <span class="hero-line">IMAGINER</span>
        <span class="hero-line">LA BEAUTÉ</span>
        <span class="hero-line">DE DEMAIN.</span>
      </h1>
      <div class="hero-subtitle">
        <span>PARIS</span>
        <span class="dot">•</span>
        <span>HAUTE PARFUMERIE & BEAUTÉ</span>
        <span class="dot">•</span>
        <span>2026</span>
      </div>
    </div>
    <div class="hero-scroll">
      <span class="scroll-text">DÉCOUVRIR</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- 02 MANIFESTO -->
  <section class="manifesto">
    <div class="manifesto-container">
      <div class="manifesto-meta">
        <span>XIONS GROUP</span>
        <span>PARIS — 2026</span>
      </div>
      <div class="manifesto-statement">
        <h2>
          Nous ne créons pas<br>
          des marques pour suivre<br>
          les catégories.<br>
          <em>Nous les créons pour<br>
          les redéfinir.</em>
        </h2>
      </div>
      <div class="manifesto-body">
        <div class="manifesto-spacer"></div>
        <div class="manifesto-text">
          <p>
            XIONS GROUP est un groupe français indépendant qui crée, 
            développe et déploie des marques de beauté premium à 
            l'international.
          </p>
          <p>
            Chacune possède son propre territoire, son langage et 
            sa vision. Notre rôle est de leur donner les moyens 
            d'exister pleinement.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 FOUNDERS - Cinematic portrait -->
  <section class="founders">
    <div class="founders-image">
      <img src="https://images.unsplash.com/photo-1542744173-8e7e53415bb0?w=2000&auto=format&fit=crop&q=90" alt="Fondateurs" loading="lazy">
      <div class="founders-overlay-shadow"></div>
    </div>
    <div class="founders-credits">
      <span>DENIS BELLAÏCHE</span>
      <span>KRIS FANG</span>
      <span>NEO SU</span>
    </div>
  </section>

  <!-- 04 BRANDS - Full-screen chapters -->
  <section class="brands">
    <!-- Brand 01: L'ENTROPISTE -->
    <article class="brand-chapter brand-chapter--lentropiste">
      <div class="brand-number">01</div>
      <div class="brand-visual">
        <img src="https://images.unsplash.com/photo-1541643600914-78b084683601?w=2000&auto=format&fit=crop" alt="L'Entropiste" loading="lazy">
      </div>
      <div class="brand-info">
        <h3 class="brand-name">L'ENTROPISTE</h3>
        <p class="brand-category">PARFUMERIE</p>
        <p class="brand-description">
          Une parfumerie de niche<br>
          libre, audacieuse et inattendue.
        </p>
        <a href="/fr/brands/lentropiste" class="brand-cta">DISCOVER</a>
      </div>
    </article>

    <!-- Brand 02: BETENOIR -->
    <article class="brand-chapter brand-chapter--betenoir">
      <div class="brand-number">02</div>
      <div class="brand-visual">
        <img src="https://images.unsplash.com/photo-1617897903246-719242758050?w=2000&auto=format&fit=crop" alt="Betenoir" loading="lazy">
      </div>
      <div class="brand-info">
        <h3 class="brand-name">BETENOIR</h3>
        <p class="brand-category">PARFUMERIE</p>
        <p class="brand-status">COMING 2026</p>
      </div>
    </article>

    <!-- Brand 03: SUNLUTION -->
    <article class="brand-chapter brand-chapter--sunlution">
      <div class="brand-number">03</div>
      <div class="brand-visual">
        <img src="https://images.unsplash.com/photo-1556228578-8c89e6adf883?w=2000&auto=format&fit=crop" alt="Sunlution" loading="lazy">
      </div>
      <div class="brand-info">
        <h3 class="brand-name">SUNLUTION</h3>
        <p class="brand-category">COSMÉTIQUE / SCIENCE</p>
        <p class="brand-description">
          La science de la lumière<br>
          au service de la peau.
        </p>
        <a href="/fr/brands/sunlution" class="brand-cta">DISCOVER</a>
      </div>
    </article>

    <!-- Brand 04: MASQLY -->
    <article class="brand-chapter brand-chapter--masqly">
      <div class="brand-number">04</div>
      <div class="brand-visual">
        <img src="https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?w=2000&auto=format&fit=crop" alt="Masqly" loading="lazy">
      </div>
      <div class="brand-info">
        <h3 class="brand-name">MASQLY</h3>
        <p class="brand-category">COSMÉTIQUE / BODY CARE</p>
        <p class="brand-description">
          Les zones oubliées<br>
          du rituel beauté.
        </p>
        <a href="/fr/brands/masqly" class="brand-cta">DISCOVER</a>
      </div>
    </article>
  </section>

  <!-- 05 AWARD MOMENT - L'Entropiste highlight -->
  <section class="award-moment">
    <div class="award-container">
      <div class="award-label">RECOGNITION</div>
      <h2 class="award-title">
        AWARD WINNING<br>
        NICHE PERFUMERY
      </h2>
      <div class="award-details">
        <div class="award-item">
          <span class="award-year">2026</span>
          <span class="award-name">Fragrance Foundation France</span>
          <span class="award-category">Parfum de niche de l'année</span>
        </div>
        <div class="award-product">
          <span>Dorian's Spleen</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 QUALITY - Compressed -->
  <section class="quality">
    <div class="quality-container">
      <div class="quality-label">OUR STANDARD</div>
      <div class="quality-keywords">
        <div class="quality-keyword">
          <h3>QUALITY</h3>
          <p>L'exigence de l'excellence</p>
        </div>
        <div class="quality-keyword">
          <h3>RESPONSIBILITY</h3>
          <p>Transparence et éthique</p>
        </div>
        <div class="quality-keyword">
          <h3>PROGRESS</h3>
          <p>Innovation durable</p>
        </div>
      </div>
      <a href="/fr/engagements" class="quality-link">Discover our commitments</a>
    </div>
  </section>

  <!-- 07 INTERNATIONAL - Archive style -->
  <section class="international">
    <div class="international-header">
      <h2>FRENCH BRANDS.<br>GLOBAL RESONANCE.</h2>
    </div>
    <div class="international-grid">
      <!-- Large feature -->
      <div class="intl-item intl-item--large">
        <img src="https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=1400&auto=format&fit=crop" alt="Oscars" loading="lazy">
        <div class="intl-info">
          <span class="intl-event">OSCARS</span>
          <span class="intl-location">HOLLYWOOD</span>
          <span class="intl-year">2026</span>
        </div>
      </div>
      <!-- Medium items -->
      <div class="intl-item intl-item--medium">
        <img src="https://images.unsplash.com/photo-1529310399831-ed472b81d589?w=800&auto=format&fit=crop" alt="Cannes" loading="lazy">
        <div class="intl-info">
          <span class="intl-event">CANNES</span>
          <span class="intl-location">FRANCE</span>
        </div>
      </div>
      <div class="intl-item intl-item--medium">
        <img src="https://images.unsplash.com/photo-1514320291840-2e0a9bf2a9ae?w=800&auto=format&fit=crop" alt="Grammy" loading="lazy">
        <div class="intl-info">
          <span class="intl-event">GRAMMYS</span>
          <span class="intl-location">LOS ANGELES</span>
        </div>
      </div>
      <!-- Small items -->
      <div class="intl-item intl-item--small">
        <img src="https://images.unsplash.com/photo-1556228453-efd6c1ff04f6?w=600&auto=format&fit=crop" alt="Paris OOH" loading="lazy">
        <div class="intl-info">
          <span class="intl-event">PARIS OOH</span>
        </div>
      </div>
      <div class="intl-item intl-item--small">
        <img src="https://images.unsplash.com/photo-1551818255-e6e10975bc17?w=600&auto=format&fit=crop" alt="London" loading="lazy">
        <div class="intl-info">
          <span class="intl-event">LONDON</span>
        </div>
      </div>
      <div class="intl-item intl-item--small">
        <img src="https://images.unsplash.com/photo-1515377905703-c4788e51af15?w=600&auto=format&fit=crop" alt="New York" loading="lazy">
        <div class="intl-info">
          <span class="intl-event">NEW YORK</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 08 MEDIA - Masonry grid -->
  <section class="media">
    <div class="media-container">
      <div class="media-header">
        <h2>SELECTED MOMENTS</h2>
        <span>2026</span>
      </div>
      <div class="media-grid">
        <div class="media-item media-item--tall">
          <img src="https://images.unsplash.com/photo-1556228578-8c89e6adf883?w=600&auto=format&fit=crop" alt="Campaign" loading="lazy">
          <div class="media-caption">
            <span class="media-number">01</span>
            <span class="media-title">CANNES</span>
          </div>
        </div>
        <div class="media-item">
          <img src="https://images.unsplash.com/photo-1541643600914-78b084683601?w=600&auto=format&fit=crop" alt="Campaign" loading="lazy">
          <div class="media-caption">
            <span class="media-number">02</span>
            <span class="media-title">PARIS OOH</span>
          </div>
        </div>
        <div class="media-item">
          <img src="https://images.unsplash.com/photo-1515377905703-c4788e51af15?w=600&auto=format&fit=crop" alt="Campaign" loading="lazy">
          <div class="media-caption">
            <span class="media-number">03</span>
            <span class="media-title">MADAME FIGARO</span>
          </div>
        </div>
        <div class="media-item media-item--wide">
          <img src="https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=1200&auto=format&fit=crop" alt="Campaign" loading="lazy">
          <div class="media-caption">
            <span class="media-number">04</span>
            <span class="media-title">HOLLYWOOD</span>
          </div>
        </div>
        <div class="media-item">
          <img src="https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?w=600&auto=format&fit=crop" alt="Campaign" loading="lazy">
          <div class="media-caption">
            <span class="media-number">05</span>
            <span class="media-title">SOCIAL</span>
          </div>
        </div>
        <div class="media-item">
          <img src="https://images.unsplash.com/photo-1529310399831-ed472b81d589?w=600&auto=format&fit=crop" alt="Campaign" loading="lazy">
          <div class="media-caption">
            <span class="media-number">06</span>
            <span class="media-title">LA</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 09 CAREERS - Minimal -->
  <section class="careers">
    <div class="careers-container">
      <h2 class="careers-title">
        BUILD WHAT<br>
        DOESN'T EXIST YET.
      </h2>
      <div class="careers-roles">
        <span>Création</span>
        <span>Marketing</span>
        <span>Digital</span>
        <span>Product</span>
        <span>Communication</span>
        <span>Operations</span>
      </div>
      <a href="/fr/contact?type=careers" class="careers-cta">VIEW OPEN POSITIONS</a>
    </div>
  </section>

  <!-- 10 CONTACT - Grand finale -->
  <section class="contact-finale">
    <div class="contact-container">
      <h2 class="contact-title">
        LET'S CREATE<br>
        WHAT COMES NEXT.
      </h2>
      <div class="contact-options">
        <a href="/fr/contact?type=general" class="contact-option">PARIS</a>
        <a href="/fr/contact?type=press" class="contact-option">PRESS</a>
        <a href="/fr/contact?type=business" class="contact-option">BUSINESS</a>
        <a href="/fr/contact?type=careers" class="contact-option">CAREERS</a>
        <a href="/fr/contact?type=partnerships" class="contact-option">PARTNERSHIPS</a>
      </div>
    </div>
  </section>

  <!-- 页脚 -->
  <Footer />
</body>
</html>

<style is:global>
  /* ==========================================================================
     GLOBAL RESET & DARK LUXURY THEME SYSTEM
     ========================================================================== */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    scroll-behavior: smooth;
    background-color: #060606;
  }

  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-weight: 400;
    color: #F0F0F0;
    background-color: #060606;
    overflow-x: hidden;
    position: relative;
  }

  /* 🎬 全局电影胶片噪点颗粒遮罩 (Grain Noise Overlay) */
  .grain-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 9999;
    opacity: 0.055;
    background: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }

  /* 🌊 黑白液态光晕流转背景 (Ambient Fluid Mesh Gradient Glow) */
  .ambient-fluid-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    background: #060606;
  }

  .fluid-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    will-change: transform;
  }

  .orb-1 {
    width: 900px;
    height: 900px;
    top: -250px;
    left: 15%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.14) 0%, rgba(30, 30, 30, 0.04) 60%, transparent 80%);
    animation: floatOrb1 22s ease-in-out infinite alternate;
  }

  .orb-2 {
    width: 1000px;
    height: 1000px;
    bottom: -350px;
    right: 5%;
    background: radial-gradient(circle, rgba(200, 200, 200, 0.09) 0%, rgba(20, 20, 20, 0.02) 65%, transparent 85%);
    animation: floatOrb2 28s ease-in-out infinite alternate;
  }

  .orb-3 {
    width: 700px;
    height: 700px;
    top: 40%;
    left: -150px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.06) 0%, transparent 75%);
    animation: floatOrb3 25s ease-in-out infinite alternate;
  }

  @keyframes floatOrb1 {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(140px, 90px) scale(1.18); }
    100% { transform: translate(-100px, 160px) scale(0.92); }
  }

  @keyframes floatOrb2 {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-120px, -140px) scale(1.22); }
    100% { transform: translate(100px, -70px) scale(0.88); }
  }

  @keyframes floatOrb3 {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(90px, -80px) scale(1.1); }
    100% { transform: translate(-60px, 110px) scale(0.95); }
  }

  /* ==========================================================================
     01 HERO SECTION - 极简奢华黑白社论
     ========================================================================== */
  .hero {
    position: relative;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 0 24px;
    background: radial-gradient(ellipse 160% 110% at 50% -35%, rgba(255, 255, 255, 0.25) 0%, rgba(40, 40, 40, 0.4) 35%, rgba(6, 6, 6, 0.98) 80%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 1200px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-logo-wrapper {
    margin-bottom: 40px;
  }

  .hero-logo-img {
    height: 68px;
    width: auto;
    filter: invert(1) drop-shadow(0 0 30px rgba(255, 255, 255, 0.2));
    user-select: none;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-logo-img:hover {
    transform: scale(1.03);
  }

  .hero-title {
    font-family: 'Inter', sans-serif;
    font-size: clamp(48px, 8vw, 110px);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: #FFFFFF;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 40px;
  }

  .hero-line {
    display: block;
    background: linear-gradient(180deg, #FFFFFF 0%, rgba(255, 255, 255, 0.75) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 11px;
    letter-spacing: 0.3em;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
  }

  .hero-subtitle .dot {
    color: rgba(255, 255, 255, 0.3);
  }

  .hero-scroll {
    position: absolute;
    bottom: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    z-index: 2;
  }

  .scroll-text {
    font-size: 9px;
    letter-spacing: 0.3em;
    color: rgba(255, 255, 255, 0.5);
  }

  .scroll-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.6) 0%, transparent 100%);
    animation: scrollPulse 2.4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  @keyframes scrollPulse {
    0% { transform: scaleY(0); transform-origin: top; }
    50% { transform: scaleY(1); transform-origin: top; }
    50.1% { transform: scaleY(1); transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }

  /* ==========================================================================
     02 MANIFESTO SECTION
     ========================================================================== */
  .manifesto {
    padding: 180px 80px;
    position: relative;
    border-top: 0.5px solid rgba(255, 255, 255, 0.08);
  }

  .manifesto-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .manifesto-meta {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 80px;
  }

  .manifesto-statement h2 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(36px, 5vw, 72px);
    font-weight: 300;
    line-height: 1.1;
    color: #FFFFFF;
    margin-bottom: 80px;
  }

  .manifesto-statement em {
    font-style: italic;
    color: rgba(255, 255, 255, 0.7);
  }

  .manifesto-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
  }

  .manifesto-text p {
    font-size: 16px;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 24px;
    font-weight: 300;
  }

  /* ==========================================================================
     03 FOUNDERS SECTION
     ========================================================================== */
  .founders {
    position: relative;
    padding: 0 80px 180px;
  }

  .founders-image {
    position: relative;
    width: 100%;
    height: 80vh;
    max-height: 900px;
    overflow: hidden;
    border-radius: 2px;
    border: 0.5px solid rgba(255, 255, 255, 0.1);
  }

  .founders-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.1);
    transition: filter 0.8s ease, transform 0.8s ease;
  }

  .founders-image:hover img {
    filter: grayscale(20%) contrast(1.05);
    transform: scale(1.02);
  }

  .founders-credits {
    display: flex;
    justify-content: space-between;
    padding-top: 24px;
    font-size: 11px;
    letter-spacing: 0.25em;
    color: rgba(255, 255, 255, 0.6);
  }

  /* ==========================================================================
     04 BRANDS SECTION
     ========================================================================== */
  .brands {
    display: flex;
    flex-direction: column;
    gap: 120px;
    padding: 0 80px 180px;
  }

  .brand-chapter {
    display: grid;
    grid-template-columns: 80px 1.2fr 1fr;
