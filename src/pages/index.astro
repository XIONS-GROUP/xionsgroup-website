---
import HeroLight from '../components/HeroLight.astro';
const pageTitle = 'XIONS GROUP';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{pageTitle}</title>
  <link rel="icon" href="/images/site/xionsgroup-icon-512.png" type="image/png" sizes="512x512" />
</head>
<body>
  <main class="holding">
    <div class="holding-media"><HeroLight /></div>
    <img class="holding-logo" src="/images/site/xions-logo.svg" alt="XIONS GROUP" width="140" height="42" />
  </main>
</body>
</html>

<style is:global>
  * { margin:0; padding:0; box-sizing:border-box; }
  html, body { width:100%; height:100%; overflow:hidden; background:#090909; }
</style>
<style>
  .holding { position:relative; width:100vw; height:100svh; display:grid; place-items:center; isolation:isolate; background:#090909; }
  .holding-media { position:absolute; inset:0; overflow:hidden; }
  /* Same treatment as the site's navigation: the black mark is inverted to white and
     differenced against the animation. Note that difference cancels against mid grey, so the
     wordmark fades wherever the X's waist passes through that value. */
  .holding-logo { position:relative; z-index:1; width:clamp(116px,17vw,176px); height:auto;
    filter:invert(1); mix-blend-mode:difference; pointer-events:none; user-select:none; }
</style>
