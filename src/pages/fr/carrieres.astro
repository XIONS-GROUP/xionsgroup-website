---
import Arrow from '../../components/Arrow.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
---
<SiteLayout title="Carrières — XIONS GROUP" description="Rejoindre les équipes de XIONS Group.">
  <PageHero eyebrow="Carrières" title="Construisons les marques de demain." intro="Nous recherchons des personnalités curieuses, ambitieuses et engagées, capables d’allier expertise et agilité." />
  <section class="section"><div class="measure join" data-reveal>
    <p class="eyebrow">Nous rejoindre</p>
    <h2 class="title-lg">Une aventure entrepreneuriale portée par l’envie de faire différemment.</h2>
    <p>Création, marketing, digital, développement produit, commerce, communication, opérations et finance : nos marques réunissent des métiers différents autour d’une même ambition.</p>
  </div></section>
  <section class="qualities"><div class="measure qualities-inner" data-reveal>
    <p class="eyebrow">Ce que nous recherchons</p>
    <div class="qualities-grid">
      <article><h2 class="title-md">Curiosité</h2><p>Regarder au-delà des usages établis et apprendre en permanence.</p></article>
      <article><h2 class="title-md">Exigence</h2><p>Porter une attention égale à l’idée, au détail et à l’exécution.</p></article>
      <article><h2 class="title-md">Engagement</h2><p>Prendre part à la construction d’un groupe en développement.</p></article>
    </div>
  </div></section>
  <section class="section section-rule"><div class="measure openings" data-reveal>
    <h2 class="title-md">Les opportunités ouvertes seront publiées sur cette page. Nous accueillons dès maintenant les candidatures spontanées.</h2>
    <a class="text-link" href="mailto:contact@xionsgroup.com?subject=Candidature%20spontanée">Candidature spontanée <Arrow /></a>
  </div></section>
</SiteLayout>
<style>
  /* Was three stacked text blocks in the same left/right split. Now: a centred statement, a
     dark band for the three qualities, then the call to apply. */
  .join { max-width:58rem; margin-inline:auto; text-align:center; }
  .join .title-lg { margin:1.5rem 0 2.5rem; }
  .join p:not(.eyebrow) { margin:0 auto; max-width:44rem; font-size:clamp(1.05rem,1.3vw,1.2rem); }
  .qualities { padding:clamp(5rem,9vw,9.5rem) var(--pad); background:#0b0b0b; color:#f4f1ec; }
  .qualities .eyebrow { margin-bottom:clamp(3rem,5vw,4.5rem); }
  .qualities-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:clamp(2.5rem,5vw,5rem); }
  .qualities-grid h2 { margin:0 0 1.1rem; }
  .qualities-grid p { margin:0; color:#cdc7bf; max-width:24rem; }
  .openings { display:grid; justify-items:start; gap:2.5rem; }
  .openings .title-md { max-width:24ch; line-height:1.15; }
  @media(max-width:800px) { .qualities-grid { grid-template-columns:1fr; gap:2.5rem; } }
</style>
