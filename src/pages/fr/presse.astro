---
import Arrow from '../../components/Arrow.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import VisualSlot from '../../components/VisualSlot.astro';
import visuals from '../../data/visuals.json';
import { visualPreview } from '../../config/visual-preview';
const selected = visuals.filter(v => v.id.startsWith('press-') && (v.src || visualPreview));
---
<SiteLayout title="Rayonnement — XIONS GROUP" description="Communication et rayonnement international des marques XIONS Group.">
  <PageHero eyebrow="Rayonnement" title="Des marques françaises. Une résonance internationale." intro="Nous construisons la visibilité de chaque maison par la presse, la culture, les talents, les événements et les marchés." />
  {selected.length > 0 && <section class="section"><div class="measure"><p class="eyebrow">Événements · Campagnes · Publications</p><div class="press-grid">{selected.map(asset => <figure><VisualSlot id={asset.id} /><figcaption>{asset.label}</figcaption></figure>)}</div></div></section>}
  <section class="section section-rule"><div class="measure split"><p class="eyebrow">Notre approche</p><div class="prose"><h2 class="title-lg">Créer des marques. Créer des moments.</h2><p>Une marque devient puissante lorsqu'elle dépasse le produit pour entrer dans la culture. Chaque activation prolonge son univers, chaque prise de parole construit son identité.</p><p>De Paris aux grandes capitales internationales, nos équipes déploient relations presse, influence, événements, affichage, digital et partenariats stratégiques.</p></div></div></section>
  <div class="cta-band"><h2>Demandes presse et partenariats</h2><a class="text-link" href="/fr/contact?type=press">Nous contacter <Arrow /></a></div>
</SiteLayout>
<style>
  .press-grid { display:grid; grid-template-columns:1fr 1fr; gap:3rem 2rem; margin-top:2rem; }
  figure { margin:0; min-width:0; } figure:first-child { grid-column:1/-1; }
  figcaption { font-size:.8rem; margin-top:1rem; }
  @media(max-width:700px) { .press-grid { grid-template-columns:1fr; } }
</style>
