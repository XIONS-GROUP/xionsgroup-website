---
import Arrow from '../../components/Arrow.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
---
<SiteLayout title="Rayonnement — XIONS GROUP" description="Communication et rayonnement international des marques XIONS Group.">
  <PageHero eyebrow="Rayonnement" title="Des marques françaises. Une résonance internationale." intro="Nous construisons la visibilité de chaque maison par la presse, la culture, les talents, les événements et les marchés." />
  
  <section class="section"><div class="measure split"><p class="eyebrow">Notre approche</p><div class="prose" data-reveal><h2 class="title-lg">Créer des marques. Créer des moments.</h2><p>Une marque devient puissante lorsqu'elle dépasse le produit pour entrer dans la culture. Chaque activation prolonge son univers, chaque prise de parole construit son identité.</p><p>De Paris aux grandes capitales internationales, nos équipes déploient relations presse, influence, événements, affichage, digital et partenariats stratégiques.</p></div></div></section>
  
  <section class="section section-rule"><div class="measure"><p class="eyebrow" style="margin-bottom:3rem">Territoires d'expression</p><div class="numbered-list"><div class="numbered-item"><span class="num">01</span><h2 class="title-md">Culture & événements</h2><p>Cinéma, mode, musique et rendez-vous internationaux.</p></div><div class="numbered-item"><span class="num">02</span><h2 class="title-md">Presse & influence</h2><p>Relations médias, talents et communautés prescriptrices.</p></div><div class="numbered-item"><span class="num">03</span><h2 class="title-md">Campagnes & marchés</h2><p>Une cohérence globale associée à une pertinence locale.</p></div></div></div></section>

  <section class="section section-dark">
    <div class="measure">
      <p class="eyebrow">Galerie d'événements</p>
      <h2 class="title-lg" style="margin-bottom:4rem">Présence internationale</h2>
      
      <div class="event-gallery">
        <div class="gallery-item">
          <div class="gallery-image">
            <img src="/images/events/cannes-placeholder.jpg" alt="Festival de Cannes" />
          </div>
          <div class="gallery-caption">
            <h3>Festival de Cannes</h3>
            <p>Présence officielle sur la Croisette</p>
          </div>
        </div>
        
        <div class="gallery-item">
          <div class="gallery-image">
            <img src="/images/events/oscar-placeholder.jpg" alt="Oscars" />
          </div>
          <div class="gallery-caption">
            <h3>Academy Awards</h3>
            <p>Activations à Los Angeles</p>
          </div>
        </div>
        
        <div class="gallery-item">
          <div class="gallery-image">
            <img src="/images/events/grammy-placeholder.jpg" alt="Grammy Awards" />
          </div>
          <div class="gallery-caption">
            <h3>Grammy Awards</h3>
            <p>Collaborations avec les talents musicaux</p>
          </div>
        </div>
        
        <div class="gallery-item">
          <div class="gallery-image">
            <img src="/images/events/fashion-placeholder.jpg" alt="Fashion Week" />
          </div>
          <div class="gallery-caption">
            <h3>Fashion Week Paris</h3>
            <p>Présence dans les défilés majeurs</p>
          </div>
        </div>
        
        <div class="gallery-item">
          <div class="gallery-image">
            <img src="/images/events/emmy-placeholder.jpg" alt="Emmy Awards" />
          </div>
          <div class="gallery-caption">
            <h3>Emmy Awards</h3>
            <p>Partenariats avec l'industrie télévisuelle</p>
          </div>
        </div>
        
        <div class="gallery-item">
          <div class="gallery-image">
            <img src="/images/events/cesar-placeholder.jpg" alt="César" />
          </div>
          <div class="gallery-caption">
            <h3>César du Cinéma</h3>
            <p>Engagement avec le cinéma français</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="cta-band"><h2>Demandes presse et partenariats</h2><a class="text-link" href="/fr/contact?type=press">Nous contacter <Arrow /></a></div>
</SiteLayout>

<style>
  .event-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .gallery-item {
    position: relative;
    overflow: hidden;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.02);
    border: 0.5px solid rgba(255, 255, 255, 0.08);
    transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery-item:hover {
    transform: translateY(-0.5rem);
  }

  .gallery-image {
    aspect-ratio: 4/3;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(255,255,255,0.05), rgba(255,255,255,0.01));
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .gallery-image::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent, rgba(194, 0, 0, 0.1));
  }

  .gallery-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.7;
    transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery-item:hover .gallery-image img {
    opacity: 1;
  }

  .gallery-caption {
    padding: 1.5rem;
  }

  .gallery-caption h3 {
    font-size: 1.25rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }

  .gallery-caption p {
    font-size: 0.9rem;
    opacity: 0.7;
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .event-gallery {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
