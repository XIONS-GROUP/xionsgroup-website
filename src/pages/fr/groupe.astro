---
import Arrow from '../../components/Arrow.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import VisualSlot from '../../components/VisualSlot.astro';
---
<SiteLayout title="Le Groupe — XIONS GROUP" description="Vision, direction et modèle de XIONS Group.">
  <PageHero eyebrow="Le Groupe" title="Un groupe nouvelle génération." intro="À la rencontre de la création, de la science et de l’innovation, XIONS Group construit des marques aux identités fortes." />
  <section class="section"><div class="measure split"><p class="eyebrow">À propos</p><div class="prose" data-reveal><h2 class="title-lg">Une vision de la beauté plus créative, plus agile et plus consciente.</h2><p>Le Groupe accompagne ses marques de leur conception à leur développement en réunissant vision entrepreneuriale, direction créative, innovation produit, expertise opérationnelle et ambition internationale.</p><p>Nous croyons que les marques de demain se construiront autour d’une vision, d’une culture et d’une expérience aussi fortes que leurs produits.</p></div></div></section>
  <section class="section section-rule" id="direction"><div class="measure direction" data-reveal>
    <div class="direction-photo"><VisualSlot id="group-team" /></div>
    <div class="direction-people">
      <p class="eyebrow">Direction</p>
      <ul>
        <li><h3>Denis Bellaïche</h3><p>Direction du Groupe</p></li>
        <li><h3>Kris Fang</h3><p>Direction du Groupe</p></li>
        <li><h3>Neo Su</h3><p>Artiste · Direction du Groupe</p></li>
      </ul>
    </div>
  </div></section>
  <div class="cta-band"><h2>Notre portefeuille</h2><a class="text-link" href="/fr/marques/">Voir les marques <Arrow /></a></div>
</SiteLayout>
<style>
  /* Portrait beside the names, not above them: the photo is vertical, so a narrow column
     keeps it at a readable size instead of filling the measure. */
  .direction { display:grid; grid-template-columns:minmax(0,22rem) minmax(0,1fr); gap:clamp(2.5rem,6vw,6rem); align-items:center; }
  .direction-people ul { list-style:none; margin:2.5rem 0 0; padding:0; display:grid; gap:clamp(2rem,3.5vw,3rem); }
  .direction-people h3 { margin:0; font-family:var(--display); font-weight:400; font-size:clamp(1.6rem,2.6vw,2.4rem); line-height:1.05; letter-spacing:-.01em; }
  .direction-people p { margin:.35rem 0 0; font-size:.8rem; color:var(--muted); letter-spacing:.02em; }
  @media(max-width:800px) {
    .direction { grid-template-columns:1fr; gap:2.5rem; }
    .direction-photo { max-width:18rem; }
  }
</style>
