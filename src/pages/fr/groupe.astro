---
import Arrow from '../../components/Arrow.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
---
<SiteLayout title="Le Groupe — XIONS GROUP" description="Vision, direction et modèle de XIONS Group.">
  <PageHero eyebrow="Le Groupe" title="Un groupe nouvelle génération." intro="À la rencontre de la création, de la science et de l’innovation, XIONS Group construit des marques aux identités fortes." />
  <section class="section"><div class="measure split"><p class="eyebrow">À propos</p><div class="prose" data-reveal><h2 class="title-lg">Une vision de la beauté plus créative, plus agile et plus consciente.</h2><p>Le Groupe accompagne ses marques de leur conception à leur développement en réunissant vision entrepreneuriale, direction créative, innovation produit, expertise opérationnelle et ambition internationale.</p><p>Nous croyons que les marques de demain se construiront autour d’une vision, d’une culture et d’une expérience aussi fortes que leurs produits.</p></div></div></section>
  <section class="section section-rule" id="direction"><div class="measure"><p class="eyebrow" style="margin-bottom:3rem">Direction</p><div class="numbered-list"><div class="numbered-item"><span class="num">01</span><h3>Denis Bellaïche</h3><p>Direction du Groupe</p></div><div class="numbered-item"><span class="num">02</span><h3>Kris Fang</h3><p>Direction du Groupe</p></div><div class="numbered-item"><span class="num">03</span><h3>Neo Su</h3><p>Artiste · Direction du Groupe</p></div></div></div></section>
  <aside class="quote-panel"><blockquote>Créer. Innover. Réinventer.</blockquote></aside>
  <div class="cta-band"><h2>Notre portefeuille</h2><a class="text-link" href="/fr/marques">Voir les marques <Arrow /></a></div>
</SiteLayout>
