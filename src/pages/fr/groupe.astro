---
import Arrow from '../../components/Arrow.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
---
<SiteLayout title="Le Groupe — XIONS GROUP" description="Vision, direction et modèle de XIONS Group.">
  <div class="hero-centered"><PageHero eyebrow="Le Groupe" title="Un groupe nouvelle génération." intro="À la rencontre de la création, de la science et de l’innovation, XIONS Group construit des marques aux identités fortes." /></div>
  <section class="section"><div class="measure about" data-reveal><p class="eyebrow">À propos</p><h2 class="title-lg">Une vision de la beauté plus créative, plus agile et plus consciente.</h2><p>Le Groupe accompagne ses marques de leur conception à leur développement en réunissant vision entrepreneuriale, direction créative, innovation produit, expertise opérationnelle et ambition internationale.</p><p>Nous croyons que les marques de demain se construiront autour d’une vision, d’une culture et d’une expérience aussi fortes que leurs produits.</p></div></section>
  <section class="section section-rule" id="direction"><div class="measure direction" data-reveal>
    <p class="eyebrow">Direction</p>
    <ul>
      <li><h3>Denis Bellaïche</h3><p>Direction du Groupe</p></li>
      <li><h3>Kris Fang</h3><p>Direction du Groupe</p></li>
      <li><h3>Neo Su</h3><p>Artiste · Direction du Groupe</p></li>
    </ul>
  </div></section>
  <div class="cta-band"><h2>Notre portefeuille</h2><a class="text-link" href="/fr/marques/">Voir les marques <Arrow /></a></div>
</SiteLayout>
<style>
  .hero-centered :global(.page-hero) { grid-template-columns:1fr; justify-items:center; text-align:center; gap:2.5rem; }
  .hero-centered :global(.page-hero .display) { max-width:20ch; margin-inline:auto; }
  .hero-centered :global(.page-hero-aside) { max-width:40rem; padding-left:0; border-left:0; align-self:auto; }
  /* The whole page reads centred, including the hero, which is left/right elsewhere. */
  .about { max-width:58rem; margin-inline:auto; text-align:center; }
  .about .title-lg { margin:1.5rem 0 2.5rem; }
  .about p { margin:0 auto 1.5rem; max-width:44rem; font-size:clamp(1.05rem,1.3vw,1.2rem); }
  .about p:last-child { margin-bottom:0; }
  .direction { text-align:center; }
  .direction ul { list-style:none; margin:clamp(3rem,5vw,4.5rem) 0 0; padding:0; display:grid; gap:clamp(2.5rem,4vw,3.5rem); }
  .direction h3 { margin:0; font-family:var(--display); font-weight:400; font-size:clamp(1.7rem,2.8vw,2.6rem); line-height:1.05; letter-spacing:-.01em; }
  .direction p { margin:.4rem 0 0; font-size:.8rem; color:var(--muted); letter-spacing:.02em; }
</style>
